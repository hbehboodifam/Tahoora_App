@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager NavManager
@inject HttpClient Http

<div class="page">
    <!-- ===== هدر موبایل (همبرگر) ===== -->
    <div class="navbar-mobile">
        <button class="btn-toggle" @onclick="ToggleSidebar">☰</button>
        <span class="brand">📊 مدیریت سفارشات</span>
    </div>

    <!-- ===== لایه‌ی تاریک پشت منو ===== -->
    @if (isSidebarOpen)
    {
        <div class="overlay" @onclick="ToggleSidebar"></div>
    }

    <!-- ===== منوی کناری ===== -->
    <div class="sidebar @(isSidebarOpen ? "open" : "")">
        <div class="brand-header">
            <h4 class="text-white mb-0">📊 مدیریت سفارشات</h4>
        </div>

        <!-- ===== داشبورد (تک‌آیتم) ===== -->
        <NavLink class="nav-link text-white" href="/" Match="NavLinkMatch.All" @onclick="CloseSidebar">
            <span>🏠 داشبورد</span>
        </NavLink>

        <!-- ===== گروه: عملیات اصلی ===== -->
        <div class="nav-group">
            <button class="nav-group-toggle" @onclick='() => ToggleGroup("operations")'>
                <span>📋 عملیات اصلی</span>
                <span class="arrow @(openGroups["operations"] ? "open" : "")">▾</span>
            </button>
            @if (openGroups["operations"])
            {
                <div class="nav-group-items">
                    <NavLink class="nav-link text-white" href="/products" @onclick="CloseSidebar">
                        <span>📦 محصولات</span>
                    </NavLink>
                    <NavLink class="nav-link text-white" href="/customers" @onclick="CloseSidebar">
                        <span>👥 مشتریان</span>
                    </NavLink>
                    <NavLink class="nav-link text-white" href="/orders/create" Match="NavLinkMatch.All" @onclick="CloseSidebar">
                        <span>➕ ثبت سفارش</span>
                    </NavLink>
                    <NavLink class="nav-link text-white" href="/orders" Match="NavLinkMatch.All" @onclick="CloseSidebar">
                        <span>📋 سفارشات</span>
                    </NavLink>
                    <NavLink class="nav-link text-white" href="/shipping" @onclick="CloseSidebar">
                        <span>🚚 بسته‌بندی و ارسال</span>
                    </NavLink>
                </div>
            }
        </div>

        <!-- ===== گروه: گزارش‌ها ===== -->
        <div class="nav-group">
            <button class="nav-group-toggle" @onclick='() => ToggleGroup("reports")'>
                <span>📊 گزارش‌ها</span>
                <span class="arrow @(openGroups["reports"] ? "open" : "")">▾</span>
            </button>
            @if (openGroups["reports"])
            {
                <div class="nav-group-items">
                    <NavLink class="nav-link text-white" href="/reports/production" @onclick="CloseSidebar">
                        <span>🏭 گزارش تولید</span>
                    </NavLink>
                    <NavLink class="nav-link text-white" href="/reports/product-sales" @onclick="CloseSidebar">
                        <span>📈 گزارش فروش محصولات</span>
                    </NavLink>
                    <NavLink class="nav-link text-white" href="/reports/customer-performance" @onclick="CloseSidebar">
                        <span>👥 گزارش عملکرد مشتریان</span>
                    </NavLink>
                    <NavLink class="nav-link text-white" href="/reports/profit-loss" @onclick="CloseSidebar">
                        <span>💹 گزارش سود و زیان</span>
                    </NavLink>
                    <NavLink class="nav-link text-white" href="/reports/debts" @onclick="CloseSidebar">
                        <span>💰 گزارش بدهی‌ها</span>
                    </NavLink>
                </div>
            }
        </div>

        <!-- ===== گروه: حسابداری ===== -->
        <div class="nav-group">
            <button class="nav-group-toggle" @onclick='() => ToggleGroup("accounting")'>
                <span>💰 حسابداری</span>
                <span class="arrow @(openGroups["accounting"] ? "open" : "")">▾</span>
            </button>
            @if (openGroups["accounting"])
            {
                <div class="nav-group-items">
                    <NavLink class="nav-link text-white" href="/expenses" @onclick="CloseSidebar">
                        <span>💸 هزینه‌ها</span>
                    </NavLink>
                    <NavLink class="nav-link text-white" href="/expense-categories" @onclick="CloseSidebar">
                        <span>🏷️ دسته‌بندی هزینه‌ها</span>
                    </NavLink>
                </div>
            }
        </div>

        <!-- ===== گروه: انبار و تولید ===== -->
        <div class="nav-group">
            <button class="nav-group-toggle" @onclick='() => ToggleGroup("inventory")'>
                <span>📦 انبار و تولید</span>
                <span class="arrow @(openGroups["inventory"] ? "open" : "")">▾</span>
            </button>
            @if (openGroups["inventory"])
            {
                <div class="nav-group-items">
                    <NavLink class="nav-link text-white" href="/production" @onclick="CloseSidebar">
                        <span>🏭 برنامه‌ی تولید</span>
                    </NavLink>
                    <NavLink class="nav-link text-white" href="/inventory" @onclick="CloseSidebar">
                        <span>📦 موجودی مازاد</span>
                    </NavLink>
                </div>
            }
        </div>

        <!-- ===== پشتیبان‌گیری ===== -->
        <NavLink class="nav-link text-white" href="/settings/backup" @onclick="CloseSidebar">
            <span>
                💾 پشتیبان‌گیری
                @if (backupHasProblem)
                {
                    <span class="badge bg-danger ms-1" title="مشکل در بکاپ">!</span>
                }
            </span>
        </NavLink>

    </div>

    <!-- ===== محتوای اصلی ===== -->
    <div class="main">
        <div class="content px-3 px-md-4">
            @Body
        </div>
    </div>
</div>

<style>
    .page {
        display: flex;
        flex-direction: row;
        direction: rtl;
        min-height: 100vh;
        position: relative;
    }

    .sidebar {
        width: 240px;
        flex-shrink: 0;
        background: linear-gradient(180deg, #1e293b 0%, #0f172a 100%);
        min-height: 100vh;
        padding: 16px 12px;
        transition: all 0.3s ease;
        position: sticky;
        top: 0;
        height: 100vh;
        overflow-y: auto;
    }

    .sidebar .brand-header {
        text-align: center;
        padding: 8px 0 20px 0;
        border-bottom: 1px solid rgba(255,255,255,0.08);
        margin-bottom: 15px;
    }
    .sidebar .brand-header h4 {
        font-size: 1.05rem;
    }

    .sidebar .nav-link {
        padding: 10px 14px;
        border-radius: 8px;
        margin-bottom: 3px;
        transition: all 0.2s;
        display: block;
        color: rgba(255,255,255,0.7) !important;
        text-decoration: none;
        font-size: 0.92rem;
    }
    .sidebar .nav-link:hover {
        background: rgba(255,255,255,0.1);
        color: white !important;
        transform: translateX(-3px);
    }
    .sidebar .nav-link.active {
        background: #6C63FF;
        color: white !important;
        font-weight: bold;
        box-shadow: 0 4px 12px rgba(108, 99, 255, 0.4);
    }

    /* ===== گروه‌های آکاردئونی ===== */
    .nav-group {
        margin-bottom: 4px;
    }
    .nav-group-toggle {
        width: 100%;
        background: transparent;
        border: none;
        color: rgba(255,255,255,0.75);
        padding: 10px 14px;
        border-radius: 8px;
        text-align: right;
        cursor: pointer;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.92rem;
        font-weight: 600;
        transition: all 0.2s;
        font-family: inherit;
    }
    .nav-group-toggle:hover {
        background: rgba(255,255,255,0.08);
        color: white;
    }
    .nav-group-toggle .arrow {
        font-size: 0.85rem;
        transition: transform 0.25s ease;
        display: inline-block;
        opacity: 0.7;
    }
    .nav-group-toggle .arrow.open {
        transform: rotate(180deg);
    }

    .nav-group-items {
        margin: 4px 8px 8px 0;
        padding-right: 10px;
        border-right: 2px solid rgba(108, 99, 255, 0.3);
        animation: slideDown 0.2s ease;
    }
    .nav-group-items .nav-link {
        padding: 8px 12px;
        font-size: 0.87rem;
        margin-bottom: 2px;
    }

    @@keyframes slideDown {
        from { opacity: 0; transform: translateY(-5px); }
        to { opacity: 1; transform: translateY(0); }
    }

    /* ===== Scrollbar زیبا ===== */
    .sidebar::-webkit-scrollbar {
        width: 6px;
    }
    .sidebar::-webkit-scrollbar-track {
        background: transparent;
    }
    .sidebar::-webkit-scrollbar-thumb {
        background: rgba(255,255,255,0.15);
        border-radius: 3px;
    }
    .sidebar::-webkit-scrollbar-thumb:hover {
        background: rgba(255,255,255,0.25);
    }

    .main {
        flex: 1;
        padding: 20px;
        background: #f8f9fa;
        min-height: 100vh;
    }
    .content {
        max-width: 1200px;
        margin: 0 auto;
    }

    .overlay {
        position: fixed;
        top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(0,0,0,0.5);
        z-index: 998;
        cursor: pointer;
    }

    .navbar-mobile {
        display: none;
        background: #1e293b;
        padding: 12px 20px;
        color: white;
        position: sticky;
        top: 0;
        z-index: 100;
        align-items: center;
        gap: 10px;
        border-bottom: 1px solid rgba(255,255,255,0.1);
    }
    .navbar-mobile .brand {
        font-size: 1.2rem;
        font-weight: bold;
    }
    .navbar-mobile .btn-toggle {
        background: transparent;
        border: none;
        color: white;
        font-size: 2rem;
        cursor: pointer;
        padding: 0 10px;
    }

    @@media (max-width: 768px) {
        .page { flex-direction: column; }
        .sidebar {
            width: 280px;
            min-height: auto;
            height: auto;
            position: fixed;
            top: 0;
            right: 0;
            bottom: 0;
            z-index: 999;
            transform: translateX(100%);
            transition: transform 0.3s ease;
            padding-top: 70px;
        }
        .sidebar.open { transform: translateX(0); }
        .navbar-mobile { display: flex; }
        .main { padding: 10px; padding-top: 0; }
        .sidebar .nav-link { text-align: center; font-size: 1rem; padding: 12px; }
        .nav-group-toggle { justify-content: center; gap: 10px; font-size: 1rem; padding: 12px; }
        .nav-group-items { border-right: none; padding-right: 0; margin-right: 0; }
        .nav-group-items .nav-link { text-align: center; }
    }

    @@media (min-width: 769px) {
        .navbar-mobile { display: none; }
        .overlay { display: none !important; }
    }
</style>

@code {
    private bool isSidebarOpen = false;

    // ===== وضعیت باز/بسته‌ی گروه‌ها =====
    private readonly Dictionary<string, bool> openGroups = new()
    {
        ["operations"] = false,
        ["reports"]    = false,
        ["accounting"] = false,
        ["inventory"]  = false
    };

    // ===== بکاپ =====
    private bool backupHasProblem = false;
    private System.Threading.Timer? _backupCheckTimer;

    protected override void OnInitialized()
    {
        // گروه مربوط به صفحه‌ی فعلی رو خودکار باز کن
        var uri = NavManager.ToBaseRelativePath(NavManager.Uri).ToLower();

        if (uri.StartsWith("products") ||
            uri.StartsWith("customers") ||
            uri.StartsWith("orders") ||
            uri.StartsWith("shipping"))
        {
            openGroups["operations"] = true;
        }
        else if (uri.StartsWith("reports"))
        {
            openGroups["reports"] = true;
        }
        else if (uri.StartsWith("expense"))
        {
            openGroups["accounting"] = true;
        }
        else if (uri.StartsWith("inventory") || uri.StartsWith("production"))
        {
            openGroups["inventory"] = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _ = CheckBackupStatusAsync();

            _backupCheckTimer = new System.Threading.Timer(async _ =>
            {
                await InvokeAsync(CheckBackupStatusAsync);
            }, null, TimeSpan.FromMinutes(5), TimeSpan.FromMinutes(5));
        }
    }

    private void ToggleSidebar() => isSidebarOpen = !isSidebarOpen;
    private void CloseSidebar() => isSidebarOpen = false;

    private void ToggleGroup(string key)
    {
        openGroups[key] = !openGroups[key];
    }

    private async Task CheckBackupStatusAsync()
    {
        try
        {
            var status = await Http.GetFromJsonAsync<BackupStatus>("api/backup/status");
            var hasProblem = status == null || !status.IsHealthy;

            if (hasProblem != backupHasProblem)
            {
                backupHasProblem = hasProblem;
                StateHasChanged();
            }
        }
        catch
        {
            // اگه API در دسترس نبود، بج رو نشون نده
        }
    }

    public void Dispose()
    {
        _backupCheckTimer?.Dispose();
    }

    public class BackupStatus
    {
        public bool IsHealthy { get; set; }
    }
}