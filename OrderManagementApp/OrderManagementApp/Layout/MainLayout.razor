@inherits LayoutComponentBase

<div class="page">
    <!-- ===== هدر موبایل (همبرگر) ===== -->
    <div class="navbar-mobile">
        <button class="btn-toggle" @onclick="ToggleSidebar">☰</button>
        <span class="brand">📊 مدیریت سفارشات</span>
    </div>

    <!-- ===== لایه‌ی تاریک پشت منو ===== -->
    @if (isSidebarOpen)
    {
        <div class="overlay" @onclick="ToggleSidebar"></div>
    }

    <!-- ===== منوی کناری ===== -->
    <div class="sidebar @(isSidebarOpen ? "open" : "")">
        <div class="text-center mb-4">
            <h4 class="text-white">📊 مدیریت سفارشات</h4>
        </div>
        <NavLink class="nav-link text-white" href="/" Match="NavLinkMatch.All" @onclick="CloseSidebar">
            <span>🏠 داشبورد</span>
        </NavLink>
        <NavLink class="nav-link text-white" href="/products" @onclick="CloseSidebar">
            <span>📦 محصولات</span>
        </NavLink>
        <NavLink class="nav-link text-white" href="/customers" @onclick="CloseSidebar">
            <span>👥 مشتریان</span>
        </NavLink>
        <NavLink class="nav-link text-white" href="/orders/create" Match="NavLinkMatch.All" @onclick="CloseSidebar">
            <span>➕ ثبت سفارش</span>
        </NavLink>
        <NavLink class="nav-link text-white" href="/orders" Match="NavLinkMatch.All" @onclick="CloseSidebar">
            <span>📋 سفارشات</span>
        </NavLink>
    </div>

    <!-- ===== محتوای اصلی ===== -->
    <div class="main">
        <div class="content px-3 px-md-4">
            @Body
        </div>
    </div>
</div>

<style>
    .page {
        display: flex;
        flex-direction: row;
        direction: rtl;
        min-height: 100vh;
        position: relative;
    }

    .sidebar {
        width: 220px;
        flex-shrink: 0;
        background: linear-gradient(180deg, #1e293b 0%, #0f172a 100%);
        min-height: 100vh;
        padding: 20px;
        transition: all 0.3s ease;
        position: sticky;
        top: 0;
        height: 100vh;
        overflow-y: auto;
    }
    .sidebar .nav-link {
        padding: 12px 20px;
        border-radius: 10px;
        margin-bottom: 5px;
        transition: all 0.2s;
        display: block;
        color: rgba(255,255,255,0.7) !important;
        text-decoration: none;
    }
    .sidebar .nav-link:hover {
        background: rgba(255,255,255,0.1);
        color: white !important;
    }
    .sidebar .nav-link.active {
        background: #6C63FF;
        color: white !important;
        font-weight: bold;
        box-shadow: 0 4px 12px rgba(108, 99, 255, 0.4);
    }

    .main {
        flex: 1;
        padding: 20px;
        background: #f8f9fa;
        min-height: 100vh;
    }
    .content {
        max-width: 1200px;
        margin: 0 auto;
    }

    .overlay {
        position: fixed;
        top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(0,0,0,0.5);
        z-index: 998;
        cursor: pointer;
    }

    .navbar-mobile {
        display: none;
        background: #1e293b;
        padding: 12px 20px;
        color: white;
        position: sticky;
        top: 0;
        z-index: 100;
        align-items: center;
        gap: 10px;
        border-bottom: 1px solid rgba(255,255,255,0.1);
    }
    .navbar-mobile .brand {
        font-size: 1.2rem;
        font-weight: bold;
    }
    .navbar-mobile .btn-toggle {
        background: transparent;
        border: none;
        color: white;
        font-size: 2rem;
        cursor: pointer;
        padding: 0 10px;
    }

    @@media (max-width: 768px) {
        .page { flex-direction: column; }
        .sidebar {
            width: 280px;
            min-height: auto;
            height: auto;
            position: fixed;
            top: 0;
            right: 0;
            bottom: 0;
            z-index: 999;
            transform: translateX(100%);
            transition: transform 0.3s ease;
            padding-top: 70px;
        }
        .sidebar.open { transform: translateX(0); }
        .navbar-mobile { display: flex; }
        .main { padding: 10px; padding-top: 0; }
        .sidebar .nav-link { text-align: center; font-size: 1.1rem; padding: 15px; }
    }

    @@media (min-width: 769px) {
        .navbar-mobile { display: none; }
        .overlay { display: none !important; }
    }
</style>

@code {
    private bool isSidebarOpen = false;
    private void ToggleSidebar() => isSidebarOpen = !isSidebarOpen;
    private void CloseSidebar() => isSidebarOpen = false;
}