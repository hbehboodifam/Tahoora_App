@page "/products"
@inject HttpClient Http
@inject IJSRuntime JsRuntime

<div class="container-fluid px-2 px-md-3" dir="rtl">
    <h2 class="fs-5 fs-md-4 mb-3">📦 مدیریت محصولات</h2>

    <button class="btn btn-primary mb-3 btn-sm" @onclick="ShowAddForm">➕ افزودن محصول جدید</button>

    @if (showForm)
    {
        <div class="card shadow-sm mb-3">
            <div class="card-header bg-primary text-white py-2">
                <h5 class="mb-0 fs-6">@(editingProduct == null ? "افزودن محصول" : "ویرایش محصول")</h5>
            </div>
            <div class="card-body p-2 p-md-3">
                <div class="row g-2">
                    <div class="col-12 col-md-6">
                        <label class="form-label small">نام محصول</label>
                        <input class="form-control form-control-sm" @bind="formModel.ProductName" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label small">قیمت واحد</label>
                        <input class="form-control form-control-sm" @bind="formModel.UnitPrice" />
                    </div>
                </div>
                <div class="mt-3">
                    <button class="btn btn-success btn-sm" @onclick="SaveProduct">💾 ذخیره</button>
                    <button class="btn btn-secondary btn-sm" @onclick="CancelForm">❌ انصراف</button>
                </div>
            </div>
        </div>
    }

    <div class="table-responsive">
        <table class="table table-hover table-sm">
            <thead>
                <tr>
                    <th class="small">نام محصول</th>
                    <th class="small">قیمت واحد</th>
                    <th class="small">عملیات</th>
                </tr>
            </thead>
            <tbody>
                @if (pagedProducts == null || !pagedProducts.Any())
                {
                    <tr><td colspan="3" class="text-center text-muted small py-2">هیچ محصولی یافت نشد</td></tr>
                }
                else
                {
                    @foreach (var p in pagedProducts)
                    {
                        <tr>
                            <td class="small">@p.ProductName</td>
                            <td class="small">@p.UnitPrice.ToString("N0")</td>
                            <td>
                                <button class="btn btn-sm btn-warning" @onclick="() => EditProduct(p)">✏️</button>
                                <button class="btn btn-sm btn-danger" @onclick="() => DeleteProduct(p.ProductId)">🗑️</button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (totalPages > 1)
    {
        <div class="d-flex justify-content-between align-items-center mt-3">
            <span class="small">صفحه @currentPage از @totalPages</span>
            <div class="d-flex gap-1 flex-wrap">
                <button class="btn btn-sm btn-outline-primary" disabled="@(currentPage == 1)" @onclick="() => GoToPage(currentPage - 1)">قبلی</button>
                @for (int i = 1; i <= totalPages; i++)
                {
                    int pageNumber = i;
                    <button class="btn btn-sm @(pageNumber == currentPage ? "btn-primary" : "btn-outline-secondary")" @onclick="() => GoToPage(pageNumber)">@pageNumber</button>
                }
                <button class="btn btn-sm btn-outline-primary" disabled="@(currentPage == totalPages)" @onclick="() => GoToPage(currentPage + 1)">بعدی</button>
            </div>
        </div>
    }
</div>

@code {
    public class ProductDto
    {
        public int ProductId { get; set; }
        public string ProductName { get; set; } = "";
        public decimal UnitPrice { get; set; }
        public string? Description { get; set; }
    }

    private List<ProductDto> allProducts = new();
    private List<ProductDto> pagedProducts = new();
    private int currentPage = 1;
    private int pageSize = 15;
    private int totalPages => (int)Math.Ceiling((double)allProducts.Count / pageSize);

    private bool showForm = false;
    private ProductDto? editingProduct = null;
    private ProductDto formModel = new();

    protected override async Task OnInitializedAsync() => await LoadProducts();

    private async Task LoadProducts()
    {
        try
        {
            allProducts = await Http.GetFromJsonAsync<List<ProductDto>>("api/Products") ?? new();
            UpdatePagedList();
        }
        catch { allProducts = new(); }
    }

    private void UpdatePagedList()
    {
        pagedProducts = allProducts.Skip((currentPage - 1) * pageSize).Take(pageSize).ToList();
    }

    private void GoToPage(int page)
    {
        if (page < 1 || page > totalPages) return;
        currentPage = page;
        UpdatePagedList();
    }

    private void ShowAddForm()
    {
        editingProduct = null;
        formModel = new();
        showForm = true;
    }

    private void EditProduct(ProductDto p)
    {
        editingProduct = p;
        formModel = new() { ProductId = p.ProductId, ProductName = p.ProductName, UnitPrice = p.UnitPrice };
        showForm = true;
    }

    private async Task SaveProduct()
    {
        try
        {
            HttpResponseMessage response;
            if (editingProduct == null)
                response = await Http.PostAsJsonAsync("api/Products", formModel);
            else
                response = await Http.PutAsJsonAsync($"api/Products/{editingProduct.ProductId}", formModel);

            if (response.IsSuccessStatusCode)
            {
                showForm = false;
                await LoadProducts();
            }
            else
            {
                var content = await response.Content.ReadAsStringAsync();
                await JsRuntime.InvokeVoidAsync("alert", $"❌ خطا: {content}");
            }
        }
        catch (Exception ex)
        {
            await JsRuntime.InvokeVoidAsync("alert", $"❌ خطا: {ex.Message}");
        }
    }

    private void CancelForm()
    {
        showForm = false;
        editingProduct = null;
        formModel = new();
    }

    private async Task DeleteProduct(int id)
    {
        var confirmed = await JsRuntime.InvokeAsync<bool>("confirm", "آیا از حذف این محصول مطمئن هستید؟");
        if (!confirmed) return;

        try
        {
            await Http.DeleteAsync($"api/Products/{id}");
            await LoadProducts();
        }
        catch { }
    }
}