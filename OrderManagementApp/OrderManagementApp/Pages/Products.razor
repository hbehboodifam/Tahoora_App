@page "/products"
@inject HttpClient Http
@inject IJSRuntime JsRuntime

<div class="container-fluid px-2 px-md-3" dir="rtl">
    <!-- ===== هدر ===== -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fs-5 fs-md-4 mb-0">📦 مدیریت محصولات</h2>
        <button class="btn btn-primary btn-sm" @onclick="ShowAddForm" disabled="@isBusy">
            ➕ افزودن محصول جدید
        </button>
    </div>

    <!-- ===== جستجو ===== -->
    <div class="mb-3 col-12 col-md-4">
        <input class="form-control form-control-sm" placeholder="🔍 جستجوی محصول..." 
               @bind="searchTerm" @bind:event="oninput" @bind:after="FilterProducts" />
    </div>

    <!-- ===== فرم افزودن / ویرایش ===== -->
    @if (showForm)
    {
        <div class="card shadow-sm mb-3 border-primary">
            <div class="card-header bg-primary text-white py-2">
                <h5 class="mb-0 fs-6">@(editingProduct == null ? "افزودن محصول" : "ویرایش محصول")</h5>
            </div>
            <div class="card-body p-2 p-md-3">

                <!-- اطلاعات پایه -->
                <h6 class="text-primary border-bottom pb-1 mb-2 fs-6">📋 اطلاعات پایه</h6>
                <div class="row g-2">
                    <div class="col-12 col-md-4">
                        <label class="form-label small">نام محصول <span class="text-danger">*</span></label>
                        <input class="form-control form-control-sm" @bind="formModel.ProductName" />
                    </div>
                    <div class="col-6 col-md-4">
                        <label class="form-label small">قیمت فروش (تومان)</label>
                        <input type="number" step="any" class="form-control form-control-sm" @bind="formModel.UnitPrice" />
                    </div>
                    <div class="col-6 col-md-4">
                        <label class="form-label small">واحد</label>
                        <select class="form-select form-select-sm" @bind="formModel.Unit">
                            <option value="کیلوگرم">کیلوگرم</option>
                            <option value="عدد">عدد</option>
                            <option value="بسته">بسته</option>
                        </select>
                    </div>
                </div>

                <!-- بهای تمام‌شده -->
                <h6 class="text-success border-bottom pb-1 mb-2 mt-3 fs-6">💵 اجزای بهای تمام‌شده</h6>
                <div class="row g-2">
                    <div class="col-6 col-md-3">
                        <label class="form-label small">مواد اولیه (تومان)</label>
                        <input type="number" step="any" class="form-control form-control-sm" @bind="formModel.MaterialCost" />
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label small">بسته‌بندی (تومان)</label>
                        <input type="number" step="any" class="form-control form-control-sm" @bind="formModel.PackagingCost" />
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label small">ضایعات و پرت (%)</label>
                        <input type="number" step="any" class="form-control form-control-sm" @bind="formModel.WastePercent" />
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label small">کارگر (تومان)</label>
                        <input type="number" step="any" class="form-control form-control-sm" @bind="formModel.LaborCost" />
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label small">سربار (%)</label>
                        <input type="number" step="any" class="form-control form-control-sm" @bind="formModel.OverheadPercent" />
                        <small class="text-muted d-block mt-1">برق، اجاره، استهلاک، تبلیغات</small>
                    </div>
                </div>

                <!-- پیش‌نمایش زنده -->
                <div class="alert alert-info mt-3 mb-2 py-2">
                    <div class="row small g-2">
                        <div class="col-6 col-md-3">💰 بهای تمام‌شده: <strong>@LiveCostPrice.ToString("N0")</strong> تومان</div>
                        <div class="col-6 col-md-3">📈 قیمت فروش: <strong>@formModel.UnitPrice.ToString("N0")</strong> تومان</div>
                        <div class="col-6 col-md-3">✅ سود هر واحد: <strong class="@(LiveProfit >= 0 ? "text-success" : "text-danger")">@LiveProfit.ToString("N0")</strong> تومان</div>
                        <div class="col-6 col-md-3">📊 حاشیه سود: <strong>@LiveMargin.ToString("N1")</strong>%</div>
                    </div>
                </div>

                <div class="mt-3">
                    <button class="btn btn-success btn-sm me-1" @onclick="SaveProduct" disabled="@isBusy">
                        @if (isBusy) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        💾 ذخیره
                    </button>
                    <button class="btn btn-secondary btn-sm" @onclick="CancelForm" disabled="@isBusy">❌ انصراف</button>
                </div>
            </div>
        </div>
    }

    <!-- =================================================== -->
    <!-- 📱 ۱. نمای مخصوص موبایل (کارت‌ها - در screens < 768px) -->
    <!-- =================================================== -->
    <div class="d-block d-md-none">
        @if (isLoading)
        {
            <div class="text-center text-muted py-4 small">در حال دریافت اطلاعات...</div>
        }
        else if (pagedProducts == null || !pagedProducts.Any())
        {
            <div class="text-center text-muted py-4 small">هیچ محصولی یافت نشد</div>
        }
        else
        {
            @foreach (var p in pagedProducts)
            {
                var profit = p.UnitPrice - p.CostPrice;
                var margin = p.UnitPrice > 0 ? (profit / p.UnitPrice) * 100 : 0;
                
                <div class="card shadow-sm mb-2 border-0 bg-body-tertiary">
                    <div class="card-body p-2 p-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="fw-bold text-dark fs-6">@p.ProductName</span>
                            <span class="badge bg-secondary-subtle text-secondary border">@p.Unit</span>
                        </div>
                        
                        <div class="row g-2 small border-top pt-2">
                            <div class="col-6">
                                <span class="text-muted d-block">قیمت فروش</span>
                                <strong>@p.UnitPrice.ToString("N0") <small>تومان</small></strong>
                            </div>
                            <div class="col-6">
                                <span class="text-muted d-block">بهای تمام‌شده</span>
                                <strong>@p.CostPrice.ToString("N0") <small>تومان</small></strong>
                            </div>
                            <div class="col-6">
                                <span class="text-muted d-block">سود هر واحد</span>
                                <strong class="@(profit >= 0 ? "text-success" : "text-danger")">
                                    @profit.ToString("N0") <small>تومان</small>
                                </strong>
                            </div>
                            <div class="col-6">
                                <span class="text-muted d-block">حاشیه سود</span>
                                <strong>@margin.ToString("N1")%</strong>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-3 pt-2 border-top">
                            <button class="btn btn-sm btn-outline-warning px-3" @onclick="() => EditProduct(p)" disabled="@isBusy">✏️ ویرایش</button>
                            <button class="btn btn-sm btn-outline-danger px-3" @onclick="() => DeleteProduct(p.ProductId)" disabled="@isBusy">🗑️ حذف</button>
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    <!-- =================================================== -->
    <!-- 🖥️ ۲. نمای مخصوص دسکتاپ و تبلت (جدول - در screens >= 768px) -->
    <!-- =================================================== -->
    <div class="table-responsive d-none d-md-block">
        <table class="table table-hover table-sm align-middle">
            <thead class="table-light">
                <tr>
                    <th class="small">نام محصول</th>
                    <th class="small">قیمت فروش (تومان)</th>
                    <th class="small">بهای تمام‌شده</th>
                    <th class="small">سود هر واحد</th>
                    <th class="small">حاشیه سود</th>
                    <th class="small">واحد</th>
                    <th class="small">عملیات</th>
                </tr>
            </thead>
            <tbody>
                @if (isLoading)
                {
                    <tr><td colspan="7" class="text-center text-muted small py-3">در حال دریافت اطلاعات...</td></tr>
                }
                else if (pagedProducts == null || !pagedProducts.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted small py-3">هیچ محصولی یافت نشد</td></tr>
                }
                else
                {
                    @foreach (var p in pagedProducts)
                    {
                        var profit = p.UnitPrice - p.CostPrice;
                        var margin = p.UnitPrice > 0 ? (profit / p.UnitPrice) * 100 : 0;
                        <tr>
                            <td class="small fw-bold">@p.ProductName</td>
                            <td class="small">@p.UnitPrice.ToString("N0")</td>
                            <td class="small">@p.CostPrice.ToString("N0")</td>
                            <td class="small @(profit >= 0 ? "text-success" : "text-danger")">
                                @profit.ToString("N0")
                            </td>
                            <td class="small">@margin.ToString("N1")%</td>
                            <td class="small">@p.Unit</td>
                            <td>
                                <button class="btn btn-sm btn-outline-warning me-1" @onclick="() => EditProduct(p)" disabled="@isBusy">✏️</button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteProduct(p.ProductId)" disabled="@isBusy">🗑️</button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- ===== صفحه‌بندی (شرک بین موبایل و دسکتاپ) ===== -->
    @if (totalPages > 1)
    {
        <div class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2">
            <span class="small text-muted">صفحه @currentPage از @totalPages (کل: @filteredProducts.Count)</span>
            <div class="d-flex gap-1 flex-wrap">
                <button class="btn btn-sm btn-outline-primary" disabled="@(currentPage == 1)" @onclick="() => GoToPage(currentPage - 1)">قبلی</button>
                @for (int i = 1; i <= totalPages; i++)
                {
                    int pageNumber = i;
                    <button class="btn btn-sm @(pageNumber == currentPage ? "btn-primary" : "btn-outline-secondary")" @onclick="() => GoToPage(pageNumber)">@pageNumber</button>
                }
                <button class="btn btn-sm btn-outline-primary" disabled="@(currentPage == totalPages)" @onclick="() => GoToPage(currentPage + 1)">بعدی</button>
            </div>
        </div>
    }
</div>

@code {
    public class ProductDto
    {
        public int ProductId { get; set; }
        public string ProductName { get; set; } = "";
        public decimal UnitPrice { get; set; }
        public string Unit { get; set; } = "کیلوگرم";
        public string? Description { get; set; }

        public decimal MaterialCost { get; set; }
        public decimal PackagingCost { get; set; }
        public decimal WastePercent { get; set; }
        public decimal LaborCost { get; set; }
        public decimal OverheadPercent { get; set; }
        public decimal CostPrice { get; set; }
    }

    private List<ProductDto> allProducts = new();
    private List<ProductDto> filteredProducts = new();
    private List<ProductDto> pagedProducts = new();
    
    private string searchTerm = "";
    private int currentPage = 1;
    private int pageSize = 15;
    private int totalPages => (int)Math.Ceiling((double)filteredProducts.Count / pageSize);

    private bool showForm = false;
    private bool isLoading = false;
    private bool isBusy = false;
    private ProductDto? editingProduct = null;
    private ProductDto formModel = new();

    private decimal LiveCostPrice => ComputeCostPrice(
        formModel.MaterialCost, formModel.PackagingCost,
        formModel.WastePercent, formModel.LaborCost, formModel.OverheadPercent);

    private decimal LiveProfit => formModel.UnitPrice - LiveCostPrice;
    private decimal LiveMargin => formModel.UnitPrice > 0 ? (LiveProfit / formModel.UnitPrice) * 100 : 0;

    protected override async Task OnInitializedAsync() => await LoadProducts();

    private static decimal ComputeCostPrice(
        decimal materialCost, decimal packagingCost,
        decimal wastePercent, decimal laborCost, decimal overheadPercent)
    {
        var baseCost     = materialCost + packagingCost;
        var afterWaste   = baseCost * (1 + wastePercent / 100m);
        var withLabor    = afterWaste + laborCost;
        var withOverhead = withLabor * (1 + overheadPercent / 100m);
        return Math.Round(withOverhead, 2);
    }

    private async Task LoadProducts()
    {
        isLoading = true;
        try
        {
            allProducts = await Http.GetFromJsonAsync<List<ProductDto>>("api/Products") ?? new();
            FilterProducts();
        }
        catch (Exception ex)
        {
            allProducts = new();
            FilterProducts();
            await JsRuntime.InvokeVoidAsync("alert", $"❌ خطا در دریافت اطلاعات: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void FilterProducts()
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            filteredProducts = allProducts.ToList();
        }
        else
        {
            filteredProducts = allProducts
                .Where(p => p.ProductName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
        currentPage = 1;
        UpdatePagedList();
    }

    private void UpdatePagedList()
    {
        pagedProducts = filteredProducts.Skip((currentPage - 1) * pageSize).Take(pageSize).ToList();
    }

    private void GoToPage(int page)
    {
        if (page < 1 || page > totalPages) return;
        currentPage = page;
        UpdatePagedList();
    }

    private void ShowAddForm()
    {
        editingProduct = null;
        formModel = new();
        showForm = true;
    }

    private void EditProduct(ProductDto p)
    {
        editingProduct = p;
        formModel = new()
        {
            ProductId = p.ProductId,
            ProductName = p.ProductName,
            UnitPrice = p.UnitPrice,
            Unit = p.Unit,
            Description = p.Description,
            MaterialCost = p.MaterialCost,
            PackagingCost = p.PackagingCost,
            WastePercent = p.WastePercent,
            LaborCost = p.LaborCost,
            OverheadPercent = p.OverheadPercent,
            CostPrice = p.CostPrice
        };
        showForm = true;
    }

    private async Task SaveProduct()
    {
        if (string.IsNullOrWhiteSpace(formModel.ProductName))
        {
            await JsRuntime.InvokeVoidAsync("alert", "⚠️ لطفاً نام محصول را وارد کنید.");
            return;
        }

        isBusy = true;
        try
        {
            formModel.CostPrice = LiveCostPrice;

            HttpResponseMessage response;
            if (editingProduct == null)
                response = await Http.PostAsJsonAsync("api/Products", formModel);
            else
                response = await Http.PutAsJsonAsync($"api/Products/{editingProduct.ProductId}", formModel);

            if (response.IsSuccessStatusCode)
            {
                showForm = false;
                await LoadProducts();
            }
            else
            {
                var content = await response.Content.ReadAsStringAsync();
                await JsRuntime.InvokeVoidAsync("alert", $"❌ خطا: {content}");
            }
        }
        catch (Exception ex)
        {
            await JsRuntime.InvokeVoidAsync("alert", $"❌ خطا: {ex.Message}");
        }
        finally
        {
            isBusy = false;
        }
    }

    private void CancelForm()
    {
        showForm = false;
        editingProduct = null;
        formModel = new();
    }

    private async Task DeleteProduct(int id)
    {
        var confirmed = await JsRuntime.InvokeAsync<bool>("confirm", "آیا از حذف این محصول مطمئن هستید؟");
        if (!confirmed) return;

        isBusy = true;
        try
        {
            var response = await Http.DeleteAsync($"api/Products/{id}");
            if (response.IsSuccessStatusCode)
            {
                await LoadProducts();
            }
            else
            {
                var content = await response.Content.ReadAsStringAsync();
                await JsRuntime.InvokeVoidAsync("alert", $"❌ خطا در حذف: {content}");
            }
        }
        catch (Exception ex)
        {
            await JsRuntime.InvokeVoidAsync("alert", $"❌ خطا: {ex.Message}");
        }
        finally
        {
            isBusy = false;
        }
    }
}