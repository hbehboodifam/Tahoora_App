@page "/customers/{Id:int}/profile"
@using OrderManagementApp.Helpers
@inject HttpClient Http
@inject IJSRuntime JsRuntime
@inject NavigationManager Nav

<div class="container-fluid px-2 px-md-3" dir="rtl">

    @if (isLoading)
    {
        <div class="text-center text-muted py-5">
            <div class="spinner-border spinner-border-sm me-2" role="status"></div>
            <span>در حال دریافت پروفایل مشتری...</span>
        </div>
    }
    else if (profile == null)
    {
        <div class="alert alert-danger mt-3 d-flex justify-content-between align-items-center">
            <span>❌ اطلاعات مشتری یافت نشد یا در دریافت داده خطایی رخ داده است.</span>
            <button class="btn btn-secondary btn-sm" @onclick="GoBack">🔙 بازگشت به لیست</button>
        </div>
    }
    else
    {
        <!-- ===== هدر ===== -->
        <div class="card shadow-sm mb-3 border-0">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                    <div>
                        <h3 class="fs-5 fs-md-4 mb-2 fw-bold text-dark">👤 @profile.Customer.FullName</h3>
                        <div class="text-muted small d-flex flex-wrap gap-3">
                            @if (!string.IsNullOrEmpty(profile.Customer.Phone))
                            {
                                <span>📞 <span dir="ltr" class="d-inline-block fw-semibold text-dark">@profile.Customer.Phone</span></span>
                            }
                            @if (!string.IsNullOrEmpty(profile.Customer.Email))
                            {
                                <span>✉️ <span dir="ltr" class="d-inline-block text-dark">@profile.Customer.Email</span></span>
                            }
                            @if (!string.IsNullOrEmpty(profile.Customer.Address))
                            {
                                <span>📍 @profile.Customer.Address</span>
                            }
                        </div>
                    </div>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="GoBack">🔙 بازگشت</button>
                </div>
            </div>
        </div>

        <!-- ===== کارت‌های آماری ===== -->
        <div class="row g-2 mb-3">
            <div class="col-6 col-md-3">
                <div class="card shadow-sm border-0 h-100" style="border-right: 4px solid #3498db !important;">
                    <div class="card-body text-center p-2 p-md-3">
                        <div class="fs-4 mb-1">📦</div>
                        <div class="text-muted small mb-1">تعداد سفارشات</div>
                        <h4 class="mb-0 fw-bold">@profile.Stats.TotalOrders</h4>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card shadow-sm border-0 h-100" style="border-right: 4px solid #2ecc71 !important;">
                    <div class="card-body text-center p-2 p-md-3">
                        <div class="fs-4 mb-1">💰</div>
                        <div class="text-muted small mb-1">مجموع خرید (تومان)</div>
                        <h4 class="mb-0 fw-bold text-success">@profile.Stats.TotalPurchases.ToString("N0")</h4>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card shadow-sm border-0 h-100" style="border-right: 4px solid @(profile.Stats.Debt > 0 ? "#e74c3c" : "#95a5a6") !important;">
                    <div class="card-body text-center p-2 p-md-3">
                        <div class="fs-4 mb-1">💳</div>
                        <div class="text-muted small mb-1">بدهی (تومان)</div>
                        <h4 class="mb-0 fw-bold @(profile.Stats.Debt > 0 ? "text-danger" : "text-muted")">
                            @profile.Stats.Debt.ToString("N0")
                        </h4>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card shadow-sm border-0 h-100" style="border-right: 4px solid #9b59b6 !important;">
                    <div class="card-body text-center p-2 p-md-3">
                        <div class="fs-4 mb-1">⏳</div>
                        <div class="text-muted small mb-1">آخرین سفارش</div>
                        <h4 class="mb-0 fw-bold">@profile.Stats.DaysSinceLastOrder <span class="fs-6 text-muted fw-normal">روز پیش</span></h4>
                    </div>
                </div>
            </div>
        </div>

        <!-- ===== بخش تحلیل RFM ===== -->
        @if (profile.Rfm != null)
        {
            <div class="card shadow-sm mb-3 border-0 bg-light">
                <div class="card-body p-2 p-md-3">
                    <div class="row g-2 align-items-center">
                        <div class="col-12 col-md-4 text-center text-md-start">
                            <span class="small text-muted me-1">دسته مشتری (RFM):</span>
                            <span class="badge bg-primary fs-6 px-3 py-2">@profile.Rfm.Category</span>
                        </div>
                        <div class="col-12 col-md-8">
                            <div class="d-flex flex-wrap justify-content-center justify-content-md-end gap-3 small">
                                <div>
                                    <strong>R</strong> (تازگی):
                                    <span class="badge @GetScoreBadgeClass(profile.Rfm.RScore)">@profile.Rfm.RScore/3</span>
                                </div>
                                <div>
                                    <strong>F</strong> (تعداد):
                                    <span class="badge @GetScoreBadgeClass(profile.Rfm.FScore)">@profile.Rfm.FScore/3</span>
                                </div>
                                <div>
                                    <strong>M</strong> (مبلغ):
                                    <span class="badge @GetScoreBadgeClass(profile.Rfm.MScore)">@profile.Rfm.MScore/3</span>
                                </div>
                                <div>
                                    <strong>امتیاز کل:</strong>
                                    <span class="badge bg-dark">@profile.Rfm.TotalScore/9</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- ===== تب‌ها (با قابلیت اسکرول افقی در صفحه کوچک) ===== -->
        <div class="profile-tabs-wrapper">
            <ul class="nav nav-tabs mb-0 profile-tabs flex-nowrap overflow-auto">
                <li class="nav-item">
                    <button class="nav-link text-nowrap @(activeTab == "orders" ? "active" : "")"
                            @onclick='() => activeTab = "orders"'>
                        📋 سفارشات (@profile.Orders.Count)
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link text-nowrap @(activeTab == "sms" ? "active" : "")"
                            @onclick='() => activeTab = "sms"'>
                        💬 پیامک‌ها (@profile.SmsLogs.Count)
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link text-nowrap @(activeTab == "notes" ? "active" : "")"
                            @onclick='() => activeTab = "notes"'>
                        📝 یادداشت‌ها (@profile.Notes.Count)
                    </button>
                </li>
            </ul>
        </div>

        <div class="card shadow-sm border-top-0 mb-4" style="border-top-left-radius: 0; border-top-right-radius: 0;">
            <div class="card-body p-2 p-md-3">

                <!-- ========================================== -->
                <!-- 📋 تب سفارشات                              -->
                <!-- ========================================== -->
                @if (activeTab == "orders")
                {
                    @if (!profile.Orders.Any())
                    {
                        <div class="text-center text-muted small py-4">هیچ سفارشی برای این مشتری ثبت نشده است.</div>
                    }
                    else
                    {
                        <!-- 📱 ۱. نمای کارت برای موبایل (< 768px) -->
                        <div class="d-block d-md-none">
                            @foreach (var o in profile.Orders)
                            {
                                <div class="card mb-2 border shadow-sm">
                                    <div class="card-body p-2 fs-7">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <span class="fw-bold text-primary">سفارش #@o.OrderId</span>
                                            <span class="badge @(o.IsPaid ? "bg-success" : "bg-danger")">
                                                @(o.IsPaid ? "پرداخت شده" : "پرداخت نشده")
                                            </span>
                                        </div>
                                        <div class="row g-1 text-muted small">
                                            <div class="col-6">📅 ثبت: @o.OrderDate.ToPersianDate()</div>
                                            <div class="col-6">🚚 تحویل: @o.DeliveryDate.ToPersianDate()</div>
                                            <div class="col-6">📦 اقلام: @o.ItemCount عدد</div>
                                            <div class="col-6 text-dark fw-bold">💰 @o.TotalAmount.ToString("N0") تومان</div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- 🖥️ ۲. نمای جدول برای دسکتاپ و تبلت (>= 768px) -->
                        <div class="table-responsive d-none d-md-block">
                            <table class="table table-hover table-sm align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th class="small">#</th>
                                        <th class="small">تاریخ ثبت</th>
                                        <th class="small">تاریخ تحویل</th>
                                        <th class="small">تعداد اقلام</th>
                                        <th class="small">مبلغ (تومان)</th>
                                        <th class="small">وضعیت پرداخت</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var o in profile.Orders)
                                    {
                                        <tr>
                                            <td class="small fw-bold">#@o.OrderId</td>
                                            <td class="small">@o.OrderDate.ToPersianDate()</td>
                                            <td class="small">@o.DeliveryDate.ToPersianDate()</td>
                                            <td class="small">@o.ItemCount</td>
                                            <td class="small fw-bold">@o.TotalAmount.ToString("N0")</td>
                                            <td>
                                                <span class="badge @(o.IsPaid ? "bg-success" : "bg-danger") small">
                                                    @(o.IsPaid ? "پرداخت شده" : "پرداخت نشده")
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }

                <!-- ========================================== -->
                <!-- 💬 تب پیامک‌ها                            -->
                <!-- ========================================== -->
                @if (activeTab == "sms")
                {
                    @if (!profile.SmsLogs.Any())
                    {
                        <div class="text-center text-muted small py-4">هیچ پیامکی برای این مشتری ارسال نشده است.</div>
                    }
                    else
                    {
                        @foreach (var sms in profile.SmsLogs)
                        {
                            <div class="card mb-2 border-0 shadow-sm" style="background: #fff8e6; border-right: 4px solid #f39c12 !important;">
                                <div class="card-body p-2 p-md-3">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="badge @(sms.SmsType == "Auto" ? "bg-info" : sms.SmsType == "Reminder" ? "bg-warning text-dark" : "bg-secondary") small">
                                            @sms.SmsType
                                        </span>
                                        <small class="text-muted">@sms.SentDate.ToPersianDate()</small>
                                    </div>
                                    <div class="small text-dark" style="white-space: pre-wrap; line-height: 1.6;">@sms.MessageText</div>
                                </div>
                            </div>
                        }
                    }
                }

                <!-- ========================================== -->
                <!-- 📝 تب یادداشت‌ها                           -->
                <!-- ========================================== -->
                @if (activeTab == "notes")
                {
                    <!-- فرم افزودن یادداشت -->
                    <div class="card mb-3 border-0 shadow-sm" style="background: #eaf4ff; border-right: 4px solid #3498db !important;">
                        <div class="card-body p-3">
                            <h6 class="fs-6 mb-2 fw-bold text-primary">➕ افزودن یادداشت جدید</h6>
                            <div class="row g-2">
                                <div class="col-12 col-md-4">
                                    <label class="form-label small mb-1">نوع یادداشت</label>
                                    <select class="form-select form-select-sm" @bind="noteForm.NoteType" disabled="@isSavingNote">
                                        <option value="تماس">📞 تماس</option>
                                        <option value="جلسه">🤝 جلسه</option>
                                        <option value="پیگیری">🔔 پیگیری</option>
                                        <option value="متفرقه">📌 متفرقه</option>
                                    </select>
                                </div>
                                <div class="col-6 col-md-4">
                                    <label class="form-label small mb-1">یادآوری بعدی (اختیاری)</label>
                                    <InputPersianDatePicker
                                        Value="@noteFollowUpDateString"
                                        ValueChanged="@((string v) => noteFollowUpDateString = v)"
                                        Placeholder="انتخاب تاریخ"
                                        CssClass="form-control form-control-sm" />
                                </div>
                                <div class="col-6 col-md-4">
                                    <label class="form-label small mb-1">ثبت‌کننده (اختیاری)</label>
                                    <input class="form-control form-control-sm" @bind="noteForm.CreatedBy" placeholder="نام شما" disabled="@isSavingNote" />
                                </div>
                                <div class="col-12">
                                    <label class="form-label small mb-1">متن یادداشت <span class="text-danger">*</span></label>
                                    <textarea class="form-control form-control-sm" rows="3" @bind="noteForm.NoteText"
                                              placeholder="مثلاً: تماس گرفتم، قرار شد سفارش بعدی رو هفته‌ی آینده ثبت کنه" disabled="@isSavingNote"></textarea>
                                </div>
                            </div>
                            <div class="mt-3">
                                <button class="btn btn-success btn-sm px-3" @onclick="SaveNote" disabled="@isSavingNote">
                                    @if (isSavingNote)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                    }
                                    💾 ذخیره یادداشت
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- لیست یادداشت‌ها -->
                    @if (!profile.Notes.Any())
                    {
                        <div class="text-center text-muted small py-4">هنوز هیچ یادداشتی برای این مشتری ثبت نشده است.</div>
                    }
                    else
                    {
                        @foreach (var note in profile.Notes)
                        {
                            <div class="card mb-2 border-0 shadow-sm" style="background: #fdfdfd; border-right: 4px solid #6c757d !important;">
                                <div class="card-body p-2 p-md-3">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <div class="d-flex flex-wrap gap-1 align-items-center">
                                            <span class="badge bg-secondary small">@note.NoteType</span>
                                            @if (note.FollowUpDate.HasValue)
                                            {
                                                <span class="badge bg-warning text-dark small">
                                                    🔔 @note.FollowUpDate.Value.ToPersianDate()
                                                </span>
                                            }
                                            @if (note.IsResolved)
                                            {
                                                <span class="badge bg-success small">✅ حل شد</span>
                                            }
                                        </div>
                                        <div class="d-flex align-items-center gap-2">
                                            <small class="text-muted fs-7">@note.CreatedDate.ToPersianDate()</small>
                                            <button class="btn btn-sm btn-outline-danger py-0 px-2 fs-7" @onclick="() => DeleteNote(note.NoteId)" disabled="@isSavingNote">🗑️</button>
                                        </div>
                                    </div>
                                    <div class="small text-dark" style="white-space: pre-wrap; line-height: 1.6;">@note.NoteText</div>
                                    @if (!string.IsNullOrEmpty(note.CreatedBy))
                                    {
                                        <div class="text-muted small mt-2 fs-7">— ثبت توسط: @note.CreatedBy</div>
                                    }
                                </div>
                            </div>
                        }
                    }
                }
            </div>
        </div>
    }
</div>

<style>
    .profile-tabs-wrapper {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }
    .profile-tabs {
        border-bottom: 2px solid #dee2e6;
    }
    .profile-tabs .nav-item {
        margin-bottom: -2px;
    }
    .profile-tabs .nav-link {
        color: #495057 !important;
        background-color: transparent;
        border: 1px solid transparent;
        border-top-left-radius: 8px;
        border-top-right-radius: 8px;
        padding: 8px 16px;
        font-size: 0.9rem;
        font-weight: 500;
        transition: all 0.15s;
    }
    .profile-tabs .nav-link:hover {
        color: #0d6efd !important;
        background-color: #f8f9fa;
        border-color: transparent;
    }
    .profile-tabs .nav-link.active {
        color: #0d6efd !important;
        background-color: #fff;
        border-color: #dee2e6 #dee2e6 #fff;
        font-weight: bold;
    }
    .fs-7 {
        font-size: 0.8rem;
    }
</style>

@code {
    [Parameter] public int Id { get; set; }

    private CustomerProfileDto? profile;
    private bool isLoading = true;
    private bool isSavingNote = false;
    private string activeTab = "orders";

    private NoteDto noteForm = new();
    private string? noteFollowUpDateString;

    protected override async Task OnInitializedAsync()
    {
        await LoadProfile();
    }

    private async Task LoadProfile()
    {
        isLoading = true;
        try
        {
            profile = await Http.GetFromJsonAsync<CustomerProfileDto>($"api/customers/{Id}/profile");
        }
        catch
        {
            profile = null;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task SaveNote()
    {
        if (string.IsNullOrWhiteSpace(noteForm.NoteText))
        {
            await JsRuntime.InvokeVoidAsync("alert", "⚠️ لطفاً متن یادداشت را وارد کنید.");
            return;
        }

        isSavingNote = true;
        noteForm.FollowUpDate = ConvertPersianToGregorian(noteFollowUpDateString);

        try
        {
            var res = await Http.PostAsJsonAsync($"api/customers/{Id}/notes", noteForm);
            if (res.IsSuccessStatusCode)
            {
                noteForm = new();
                noteFollowUpDateString = null;
                await LoadProfile();
                activeTab = "notes";
            }
            else
            {
                var msg = await res.Content.ReadAsStringAsync();
                await JsRuntime.InvokeVoidAsync("alert", $"❌ خطای ثبت یادداشت: {msg}");
            }
        }
        catch (Exception ex)
        {
            await JsRuntime.InvokeVoidAsync("alert", $"❌ خطای سیستم: {ex.Message}");
        }
        finally
        {
            isSavingNote = false;
        }
    }

    private async Task DeleteNote(int noteId)
    {
        var confirmed = await JsRuntime.InvokeAsync<bool>("confirm", "آیا از حذف این یادداشت اطمینان دارید؟");
        if (!confirmed) return;

        isSavingNote = true;
        try
        {
            var res = await Http.DeleteAsync($"api/customers/{Id}/notes/{noteId}");
            if (res.IsSuccessStatusCode)
            {
                await LoadProfile();
                activeTab = "notes";
            }
            else
            {
                var msg = await res.Content.ReadAsStringAsync();
                await JsRuntime.InvokeVoidAsync("alert", $"❌ خطا در حذف یادداشت: {msg}");
            }
        }
        catch (Exception ex)
        {
            await JsRuntime.InvokeVoidAsync("alert", $"❌ خطای سیستم: {ex.Message}");
        }
        finally
        {
            isSavingNote = false;
        }
    }

    private void GoBack() => Nav.NavigateTo("/customers");

    private string GetScoreBadgeClass(int score) => score switch
    {
        3 => "bg-success",
        2 => "bg-warning text-dark",
        _ => "bg-danger"
    };

    private DateTime? ConvertPersianToGregorian(string? persianDate)
    {
        if (string.IsNullOrWhiteSpace(persianDate)) return null;
        try
        {
            var normalized = persianDate
                .Replace('۰', '0').Replace('۱', '1').Replace('۲', '2').Replace('۳', '3').Replace('۴', '4')
                .Replace('۵', '5').Replace('۶', '6').Replace('۷', '7').Replace('۸', '8').Replace('۹', '9');
            var parts = normalized.Split('/');
            if (parts.Length != 3) return null;
            if (!int.TryParse(parts[0], out int y)) return null;
            if (!int.TryParse(parts[1], out int m)) return null;
            if (!int.TryParse(parts[2], out int d)) return null;
            var pc = new System.Globalization.PersianCalendar();
            return pc.ToDateTime(y, m, d, 0, 0, 0, 0);
        }
        catch { return null; }
    }

    // ===== DTO ها =====
    public class CustomerProfileDto
    {
        public CustomerBasicDto Customer { get; set; } = new();
        public StatsDto Stats { get; set; } = new();
        public RfmDto? Rfm { get; set; }
        public List<OrderDto> Orders { get; set; } = new();
        public List<SmsDto> SmsLogs { get; set; } = new();
        public List<NoteDto> Notes { get; set; } = new();
    }

    public class CustomerBasicDto
    {
        public int CustomerId { get; set; }
        public string FullName { get; set; } = "";
        public string? Phone { get; set; }
        public string? Email { get; set; }
        public string? Address { get; set; }
    }

    public class StatsDto
    {
        public int TotalOrders { get; set; }
        public decimal TotalPurchases { get; set; }
        public decimal Debt { get; set; }
        public int DaysSinceLastOrder { get; set; }
    }

    public class RfmDto
    {
        public int OrderCount { get; set; }
        public decimal TotalPurchase { get; set; }
        public int RScore { get; set; }
        public int FScore { get; set; }
        public int MScore { get; set; }
        public int TotalScore { get; set; }
        public string Category { get; set; } = "";
        public string CategoryKey { get; set; } = "";
    }

    public class OrderDto
    {
        public int OrderId { get; set; }
        public DateTime OrderDate { get; set; }
        public DateTime DeliveryDate { get; set; }
        public decimal TotalAmount { get; set; }
        public bool IsPaid { get; set; }
        public DateTime? PaymentDate { get; set; }
        public string? Notes { get; set; }
        public int ItemCount { get; set; }
    }

    public class SmsDto
    {
        public int LogId { get; set; }
        public DateTime SentDate { get; set; }
        public string? MessageText { get; set; }
        public string? SmsType { get; set; }
    }

    public class NoteDto
    {
        public int NoteId { get; set; }
        public string NoteText { get; set; } = "";
        public string NoteType { get; set; } = "متفرقه";
        public DateTime CreatedDate { get; set; }
        public bool IsResolved { get; set; }
        public DateTime? FollowUpDate { get; set; }
        public string? CreatedBy { get; set; }
    }
}