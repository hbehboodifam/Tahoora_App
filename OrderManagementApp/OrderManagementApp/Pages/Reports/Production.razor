@page "/reports/production"
@using OrderManagementApp.Helpers
@inject HttpClient Http
@inject IJSRuntime JsRuntime

<div class="container-fluid px-2 px-md-3" dir="rtl">
    <h2 class="fs-5 fs-md-4 mb-3">🏭 گزارش تولید</h2>

    <!-- ===== فیلترها ===== -->
    <div class="row g-2 mb-3">
        <div class="col-6 col-md-3">
            <label class="form-label small">از تاریخ تحویل</label>
            <InputPersianDatePicker
                Value="@fromDateString"
                ValueChanged="@((string value) => { fromDateString = value; })"
                Placeholder="انتخاب تاریخ"
                CssClass="form-control form-control-sm"
            />
        </div>
        <div class="col-6 col-md-3">
            <label class="form-label small">تا تاریخ تحویل</label>
            <InputPersianDatePicker
                Value="@toDateString"
                ValueChanged="@((string value) => { toDateString = value; })"
                Placeholder="انتخاب تاریخ"
                CssClass="form-control form-control-sm"
            />
        </div>
        <div class="col-12 col-md-3 d-flex align-items-end">
            <button class="btn btn-primary btn-sm w-100" @onclick="ApplyFilter">
                🔍 اعمال فیلتر
            </button>
        </div>
        <div class="col-12 col-md-3 d-flex align-items-end">
            <button class="btn btn-success btn-sm w-100" @onclick="ExportToExcel">
                📤 خروجی اکسل
            </button>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center text-muted mt-5">
            <p>⏳ در حال بارگذاری...</p>
        </div>
    }
    else if (report == null || (report.Summary.Count == 0 && report.Details.Count == 0))
    {
        <div class="alert alert-info">
            در بازه‌ی انتخاب‌شده، هیچ سفارشی وجود ندارد.
        </div>
    }
    else
    {
        <!-- ===== کارت‌های آماری ===== -->
        <div class="row g-2 mb-3">
            <div class="col-6 col-md-4">
                <div class="card shadow-sm border-0" style="border-right: 4px solid #3498db !important;">
                    <div class="card-body text-center p-2 p-md-3">
                        <h5 class="mb-1">📦</h5>
                        <h6 class="text-muted small mb-0">تعداد کل سفارشات</h6>
                        <h4 class="mb-0">@report.TotalOrders</h4>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-4">
                <div class="card shadow-sm border-0" style="border-right: 4px solid #2ecc71 !important;">
                    <div class="card-body text-center p-2 p-md-3">
                        <h5 class="mb-1">⚖️</h5>
                        <h6 class="text-muted small mb-0">جمع کل وزنی (کیلو)</h6>
                        <h4 class="mb-0">@report.TotalWeight.ToString("N2")</h4>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-4">
                <div class="card shadow-sm border-0" style="border-right: 4px solid #9b59b6 !important;">
                    <div class="card-body text-center p-2 p-md-3">
                        <h5 class="mb-1">📋</h5>
                        <h6 class="text-muted small mb-0">تعداد محصولات متمایز</h6>
                        <h4 class="mb-0">@report.DistinctProducts</h4>
                    </div>
                </div>
            </div>
        </div>

        <!-- ===== جدول خلاصه‌ی تولید ===== -->
        <div class="card shadow-sm mb-3">
            <div class="card-header bg-primary text-white py-2">
                <h5 class="mb-0 fs-6">📊 خلاصه‌ی تولید بر اساس محصول</h5>
            </div>
            <div class="card-body p-2 p-md-3">
                <div class="table-responsive">
                    <table class="table table-hover table-sm">
                        <thead>
                            <tr>
                                <th class="small">نام محصول</th>
                                <th class="small">جمع تعداد (کیلو)</th>
                                <th class="small">تعداد سفارش</th>
                                <th class="small">درصد از کل</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in report.Summary)
                            {
                                <tr>
                                    <td class="small">@s.ProductName</td>
                                    <td class="small fw-bold">@s.TotalQuantity.ToString("N2")</td>
                                    <td class="small">@s.OrderCount</td>
                                    <td class="small">@s.Percentage.ToString("F1")%</td>
                                </tr>
                            }
                            <tr class="table-info fw-bold">
                                <td class="small">جمع کل</td>
                                <td class="small">@report.TotalWeight.ToString("N2")</td>
                                <td class="small">@report.TotalOrders</td>
                                <td class="small">100%</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- ===== جدول تفصیلی سفارشات ===== -->
        <div class="card shadow-sm">
            <div class="card-header bg-success text-white py-2">
                <h5 class="mb-0 fs-6">📋 سفارشات تفصیلی (مرتب‌شده بر اساس تاریخ تحویل → محصول)</h5>
            </div>
            <div class="card-body p-2 p-md-3">
                <div class="table-responsive">
                    <table class="table table-hover table-sm">
                        <thead>
                            <tr>
                                <th class="small">تاریخ تحویل</th>
                                <th class="small">محصول</th>
                                <th class="small">مشتری</th>
                                <th class="small">تعداد (کیلو)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in report.Details)
                            {
                                <tr>
                                    <td class="small">@d.DeliveryDate.ToPersianDate()</td>
                                    <td class="small">@d.ProductName</td>
                                    <td class="small">@d.CustomerName</td>
                                    <td class="small">@d.Quantity.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private string? fromDateString;
    private string? toDateString;
    private DateTime? fromDate;
    private DateTime? toDate;
    private ProductionReportDto? report;
    private bool isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        // پیش‌فرض: از امروز تا ۷ روز آینده
        var today = DateTime.Now;
        var nextWeek = today.AddDays(7);

        var pc = new System.Globalization.PersianCalendar();
        fromDateString = $"{pc.GetYear(today):0000}/{pc.GetMonth(today):00}/{pc.GetDayOfMonth(today):00}";
        toDateString = $"{pc.GetYear(nextWeek):0000}/{pc.GetMonth(nextWeek):00}/{pc.GetDayOfMonth(nextWeek):00}";

        fromDate = today;
        toDate = nextWeek;

        await LoadReport();
    }

    private async Task ApplyFilter()
    {
        fromDate = ConvertPersianToGregorian(fromDateString);
        toDate = ConvertPersianToGregorian(toDateString);
        await LoadReport();
    }

    private async Task LoadReport()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            var url = "api/Reports/production";
            var query = new List<string>();

            if (fromDate.HasValue)
                query.Add($"from={fromDate.Value:yyyy-MM-dd}");
            if (toDate.HasValue)
                query.Add($"to={toDate.Value:yyyy-MM-dd}");

            if (query.Any())
                url += "?" + string.Join("&", query);

            report = await Http.GetFromJsonAsync<ProductionReportDto>(url);
        }
        catch (Exception ex)
        {
            await JsRuntime.InvokeVoidAsync("alert", $"❌ خطا در بارگذاری: {ex.Message}");
            report = null;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private DateTime? ConvertPersianToGregorian(string? persianDate)
    {
        if (string.IsNullOrEmpty(persianDate)) return null;

        try
        {
            var normalized = persianDate
                .Replace('۰', '0').Replace('۱', '1').Replace('۲', '2').Replace('۳', '3').Replace('۴', '4')
                .Replace('۵', '5').Replace('۶', '6').Replace('۷', '7').Replace('۸', '8').Replace('۹', '9');

            var parts = normalized.Split('/');
            if (parts.Length != 3) return null;

            if (!int.TryParse(parts[0], out int y)) return null;
            if (!int.TryParse(parts[1], out int m)) return null;
            if (!int.TryParse(parts[2], out int d)) return null;

            var pc = new System.Globalization.PersianCalendar();
            return pc.ToDateTime(y, m, d, 0, 0, 0, 0);
        }
        catch
        {
            return null;
        }
    }

    private async Task ExportToExcel()
    {
        if (report == null || (report.Summary.Count == 0 && report.Details.Count == 0))
        {
            await JsRuntime.InvokeVoidAsync("alert", "داده‌ای برای خروجی وجود ندارد.");
            return;
        }

        var sb = new System.Text.StringBuilder();

        // ===== Sheet 1: خلاصه تولید =====
        sb.AppendLine("خلاصه تولید");
        sb.AppendLine("نام محصول,جمع تعداد (کیلو),تعداد سفارش,درصد از کل");
        foreach (var s in report.Summary)
        {
            sb.AppendLine($"{s.ProductName},{s.TotalQuantity:N2},{s.OrderCount},{s.Percentage:F1}%");
        }
        sb.AppendLine();

        // ===== Sheet 2: سفارشات تفصیلی =====
        sb.AppendLine("سفارشات تفصیلی");
        sb.AppendLine("تاریخ تحویل,محصول,مشتری,تعداد (کیلو)");
        foreach (var d in report.Details)
        {
            sb.AppendLine($"{d.DeliveryDate.ToPersianDate()},{d.ProductName},{d.CustomerName},{d.Quantity:N2}");
        }

        var csv = sb.ToString();
        var bytes = System.Text.Encoding.UTF8.GetPreamble().Concat(System.Text.Encoding.UTF8.GetBytes(csv)).ToArray();
        var base64 = Convert.ToBase64String(bytes);
        var fileName = $"ProductionReport_{DateTime.Now:yyyyMMdd_HHmmss}.csv";

        await JsRuntime.InvokeVoidAsync("downloadFileFromBase64", fileName, base64);
    }

    public class ProductionReportDto
    {
        public List<SummaryItem> Summary { get; set; } = new();
        public List<DetailItem> Details { get; set; } = new();
        public int TotalOrders { get; set; }
        public decimal TotalWeight { get; set; }
        public int DistinctProducts { get; set; }
    }

    public class SummaryItem
    {
        public string ProductName { get; set; } = "";
        public decimal TotalQuantity { get; set; }
        public int OrderCount { get; set; }
        public double Percentage { get; set; }
    }

    public class DetailItem
    {
        public DateTime DeliveryDate { get; set; }
        public string ProductName { get; set; } = "";
        public string CustomerName { get; set; } = "";
        public decimal Quantity { get; set; }
    }
}