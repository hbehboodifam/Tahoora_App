@page "/reports/debts"
@using OrderManagementApp.Helpers
@inject HttpClient Http
@inject IJSRuntime JsRuntime
@inject NavigationManager Nav

<div class="container-fluid px-2 px-md-3" dir="rtl">
    <h2 class="fs-5 fs-md-4 mb-3">💰 گزارش بدهی‌ها</h2>

    @if (isLoading)
    {
        <div class="text-center text-muted mt-5">
            <p>⏳ در حال بارگذاری...</p>
        </div>
    }
    else if (report == null || !report.HasData)
    {
        <div class="alert alert-success mt-3">
            ✅ هیچ بدهی پرداخت‌نشده‌ای وجود ندارد.
        </div>
    }
    else
    {
        <!-- ===== کارت‌های خلاصه ===== -->
        <div class="row g-2 mb-3">
            <div class="col-6 col-md-3">
                <div class="card shadow-sm border-0" style="border-right: 4px solid #3498db !important;">
                    <div class="card-body text-center p-2 p-md-3">
                        <h5 class="mb-1">👥</h5>
                        <h6 class="text-muted small mb-0">تعداد بدهکاران</h6>
                        <h4 class="mb-0">@report.DebtorCount</h4>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card shadow-sm border-0" style="border-right: 4px solid #e74c3c !important;">
                    <div class="card-body text-center p-2 p-md-3">
                        <h5 class="mb-1">💰</h5>
                        <h6 class="text-muted small mb-0">جمع کل بدهی</h6>
                        <h4 class="mb-0 text-danger">@report.TotalDebt.ToString("N0")</h4>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card shadow-sm border-0" style="border-right: 4px solid #f39c12 !important;">
                    <div class="card-body text-center p-2 p-md-3">
                        <h5 class="mb-1">📊</h5>
                        <h6 class="text-muted small mb-0">میانگین بدهی</h6>
                        <h4 class="mb-0">@report.AverageDebt.ToString("N0")</h4>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card shadow-sm border-0" style="border-right: 4px solid #9b59b6 !important;">
                    <div class="card-body text-center p-2 p-md-3">
                        <h5 class="mb-1">🏆</h5>
                        <h6 class="text-muted small mb-0">بیشترین بدهی</h6>
                        <h5 class="mb-0">@TopDebtorAmount.ToString("N0")</h5>
                    </div>
                </div>
            </div>
        </div>

        <!-- ===== فیلتر + سورت موبایل + خروجی ===== -->
        <div class="card shadow-sm mb-3">
            <div class="card-body p-2 p-md-3">
                <div class="row g-2 align-items-end">
                    <div class="col-12 col-md-4">
                        <label class="form-label small">حداقل مبلغ بدهی (تومان)</label>
                        <input type="number" class="form-control form-control-sm"
                               @bind="minAmount" placeholder="مثلاً 1000000" />
                    </div>

                    <!-- سورت مخصوص موبایل -->
                    <div class="col-12 d-md-none">
                        <label class="form-label small">مرتب‌سازی بر اساس</label>
                        <select class="form-select form-select-sm" @bind="sortColumn" @bind:after="OnMobileSortChanged">
                            <option value="TotalDebt">بیشترین بدهی</option>
                            <option value="DaysSinceOldest">قدیمی‌ترین بدهی</option>
                            <option value="CustomerName">نام مشتری</option>
                            <option value="UnpaidOrderCount">تعداد سفارش</option>
                        </select>
                    </div>

                    <div class="col-6 col-md-2">
                        <button class="btn btn-primary btn-sm w-100" @onclick="LoadReport">
                            🔍 اعمال
                        </button>
                    </div>
                    <div class="col-6 col-md-2">
                        <button class="btn btn-outline-secondary btn-sm w-100" @onclick="ClearFilter">
                            🧹 پاک کردن
                        </button>
                    </div>
                    <div class="col-12 col-md-4 text-md-end">
                        <button class="btn btn-success btn-sm w-100 w-md-auto" @onclick="ExportToCsv">
                            📤 خروجی CSV
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- ===== جدول بدهکاران ===== -->
        <div class="card shadow-sm">
            <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fs-6">📋 لیست بدهکاران</h5>
                <small class="text-muted d-none d-md-inline">
                    برای سورت، روی عنوان ستون کلیک کن
                </small>
            </div>
            <div class="card-body p-2">
                <div class="table-responsive">
                    <table class="table table-hover table-sm align-middle table-cards">
                        <thead>
                            <tr>
                                <th class="small d-none d-md-table-cell">#</th>
                                <th class="small sortable" @onclick='() => SortBy("CustomerName")'>
                                    نام مشتری @SortIcon("CustomerName")
                                </th>
                                <th class="small d-none d-md-table-cell">تلفن</th>
                                <th class="small sortable" @onclick='() => SortBy("TotalDebt")'>
                                    مبلغ بدهی (تومان) @SortIcon("TotalDebt")
                                </th>
                                <th class="small sortable" @onclick='() => SortBy("UnpaidOrderCount")'>
                                    تعداد سفارش @SortIcon("UnpaidOrderCount")
                                </th>
                                <th class="small sortable" @onclick='() => SortBy("OldestOrderDate")'>
                                    قدیمی‌ترین سفارش @SortIcon("OldestOrderDate")
                                </th>
                                <th class="small sortable" @onclick='() => SortBy("DaysSinceOldest")'>
                                    سن بدهی @SortIcon("DaysSinceOldest")
                                </th>
                                <th class="small">عملیات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ var i = 0; }
                            @foreach (var d in SortedDebtors)
                            {
                                i++;
                                <tr>
                                    <td class="small d-none d-md-table-cell">@i</td>
                                    <td class="small fw-bold td-title" data-label="نام مشتری">
                                        @d.CustomerName
                                    </td>
                                    <td class="small td-hide-mobile" data-label="تلفن">
                                        @if (!string.IsNullOrEmpty(d.Phone))
                                        {
                                            <span dir="ltr">@d.Phone</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">—</span>
                                        }
                                    </td>
                                    <td class="small fw-bold text-danger" data-label="مبلغ بدهی">
                                        @d.TotalDebt.ToString("N0")
                                    </td>
                                    <td class="small" data-label="تعداد سفارش">
                                        @d.UnpaidOrderCount
                                    </td>
                                    <td class="small" data-label="قدیمی‌ترین سفارش">
                                        @d.OldestOrderDate.ToPersianDate()
                                    </td>
                                    <td class="small" data-label="سن بدهی">
                                        <span class="badge @GetAgeBadgeClass(d.AgeCategory)">
                                            @d.DaysSinceOldest روز
                                        </span>
                                    </td>
                                    <td class="td-actions" data-label="عملیات">
                                        <button class="btn btn-sm btn-info" title="پروفایل"
                                                @onclick="() => GoToProfile(d.CustomerId)">👤</button>
                                        @if (!string.IsNullOrEmpty(d.Phone))
                                        {
                                            <button class="btn btn-sm btn-warning" title="پیامک یادآوری"
                                                    @onclick="() => OpenSmsModal(d)">
                                                📱
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-secondary" title="شماره تلفن ثبت نشده" disabled>📱</button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="table-info fw-bold">
                                <td colspan="3" class="small d-none d-md-table-cell">جمع کل</td>
                                <td class="small text-danger" data-label="جمع کل">@report.TotalDebt.ToString("N0")</td>
                                <td colspan="4"></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

<!-- ==================================================================== -->
<!-- مودال ویرایش و ارسال پیامک -->
<!-- ==================================================================== -->
@if (smsDebtor != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered modal-lg modal-fullscreen-sm-down">
            <div class="modal-content">
                <div class="modal-header bg-warning text-dark py-2">
                    <h5 class="modal-title fs-6">📱 ارسال یادآوری — @smsDebtor.CustomerName</h5>
                    <button type="button" class="btn-close" @onclick="CloseSmsModal"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-info py-2 small mb-2">
                        <div><strong>مبلغ بدهی:</strong> @smsDebtor.TotalDebt.ToString("N0") تومان</div>
                        <div><strong>تعداد سفارش پرداخت‌نشده:</strong> @smsDebtor.UnpaidOrderCount</div>
                        <div><strong>قدیمی‌ترین بدهی:</strong> @smsDebtor.DaysSinceOldest روز پیش</div>
                        <div><strong>تلفن:</strong> <span dir="ltr">@smsDebtor.Phone</span></div>
                    </div>

                    <label class="form-label small">متن پیامک (قابل ویرایش)</label>
                    <textarea class="form-control form-control-sm" rows="10"
                              @bind="smsMessage" @bind:event="oninput"></textarea>

                    <div class="text-muted small mt-2">
                        💡 می‌تونی متن رو به سلیقه‌ی خودت تغییر بدی.
                    </div>
                </div>
                <div class="modal-footer py-2">
                    <button class="btn btn-secondary btn-sm" @onclick="CloseSmsModal">انصراف</button>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="ResetSmsMessage">
                        🔄 متن پیش‌فرض
                    </button>
                    <button class="btn btn-warning btn-sm" @onclick="SendSms"
                            disabled="@isSendingSms">
                        @if (isSendingSms)
                        {
                            <span>⏳ در حال ارسال...</span>
                        }
                        else
                        {
                            <span>📤 ارسال</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .sortable {
        cursor: pointer;
        user-select: none;
    }
    .sortable:hover {
        background-color: #f0f0f0;
    }
</style>

@code {
    private DebtReportDto? report;
    private bool isLoading = true;
    private decimal? minAmount;

    // ===== سورت =====
    private string sortColumn = "TotalDebt";
    private bool sortAsc = false;

    // ===== مودال پیامک =====
    private DebtorDto? smsDebtor;
    private string smsMessage = "";
    private bool isSendingSms = false;

    private decimal TopDebtorAmount =>
        report?.Debtors?.FirstOrDefault()?.TotalDebt ?? 0;

    private IEnumerable<DebtorDto> SortedDebtors
    {
        get
        {
            if (report?.Debtors == null) return Enumerable.Empty<DebtorDto>();

            var list = report.Debtors.AsEnumerable();
            list = sortColumn switch
            {
                "CustomerName" => sortAsc
                    ? list.OrderBy(x => x.CustomerName)
                    : list.OrderByDescending(x => x.CustomerName),
                "TotalDebt" => sortAsc
                    ? list.OrderBy(x => x.TotalDebt)
                    : list.OrderByDescending(x => x.TotalDebt),
                "UnpaidOrderCount" => sortAsc
                    ? list.OrderBy(x => x.UnpaidOrderCount)
                    : list.OrderByDescending(x => x.UnpaidOrderCount),
                "OldestOrderDate" => sortAsc
                    ? list.OrderBy(x => x.OldestOrderDate)
                    : list.OrderByDescending(x => x.OldestOrderDate),
                "DaysSinceOldest" => sortAsc
                    ? list.OrderBy(x => x.DaysSinceOldest)
                    : list.OrderByDescending(x => x.DaysSinceOldest),
                _ => list.OrderByDescending(x => x.TotalDebt)
            };
            return list;
        }
    }

    protected override async Task OnInitializedAsync() => await LoadReport();

    private async Task LoadReport()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            var url = "api/reports/debts";
            if (minAmount.HasValue && minAmount.Value > 0)
                url += $"?minAmount={minAmount.Value}";

            report = await Http.GetFromJsonAsync<DebtReportDto>(url);
        }
        catch (Exception ex)
        {
            await JsRuntime.InvokeVoidAsync("alert", $"❌ خطا: {ex.Message}");
            report = null;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ClearFilter()
    {
        minAmount = null;
        await LoadReport();
    }

    private void GoToProfile(int customerId)
    {
        Nav.NavigateTo($"/customers/{customerId}/profile");
    }

    // ===== سورت =====
    private void SortBy(string column)
    {
        if (sortColumn == column)
        {
            sortAsc = !sortAsc;
        }
        else
        {
            sortColumn = column;
            sortAsc = column == "CustomerName";
        }
    }

    private void OnMobileSortChanged()
    {
        // سورت از dropdown موبایل — همیشه نزولی برای اعداد، صعودی برای اسم
        sortAsc = sortColumn == "CustomerName";
        StateHasChanged();
    }

    private MarkupString SortIcon(string column)
    {
        if (sortColumn != column)
            return new MarkupString("<span style='opacity:0.3;'>⇅</span>");

        return sortAsc
            ? new MarkupString("<span style='color:#0d6efd;'>▲</span>")
            : new MarkupString("<span style='color:#0d6efd;'>▼</span>");
    }

    // ===== مودال پیامک =====
    private void OpenSmsModal(DebtorDto d)
    {
        smsDebtor = d;
        smsMessage = BuildDefaultMessage(d);
    }

    private void CloseSmsModal()
    {
        smsDebtor = null;
        smsMessage = "";
    }

    private void ResetSmsMessage()
    {
        if (smsDebtor != null)
            smsMessage = BuildDefaultMessage(smsDebtor);
    }

    private string BuildDefaultMessage(DebtorDto d)
    {
        return $"سلام {d.CustomerName} عزیز،\n\n" +
               $"مبلغ {d.TotalDebt:N0} تومان از سفارشات قبلی شما پرداخت نشده است.\n" +
               $"لطفاً در اسرع وقت نسبت به تسویه اقدام فرمایید.\n\n" +
               $"با تشکر\n" +
               $"تیم طهورا پروتئین\n" +
               $"https://ble.ir/ProteinTahoora";
    }

    private async Task SendSms()
    {
        if (smsDebtor == null) return;

        if (string.IsNullOrWhiteSpace(smsMessage))
        {
            await JsRuntime.InvokeVoidAsync("alert", "متن پیامک نمی‌تواند خالی باشد.");
            return;
        }

        isSendingSms = true;
        StateHasChanged();

        try
        {
            var dto = new { Message = smsMessage };
            var res = await Http.PostAsJsonAsync(
                $"api/reports/send-debt-reminder/{smsDebtor.CustomerId}", dto);

            if (res.IsSuccessStatusCode)
            {
                CloseSmsModal();
                await JsRuntime.InvokeVoidAsync("alert", "✅ پیامک یادآوری ارسال شد.");
            }
            else
            {
                var msg = await res.Content.ReadAsStringAsync();
                await JsRuntime.InvokeVoidAsync("alert", $"❌ {msg}");
            }
        }
        catch (Exception ex)
        {
            await JsRuntime.InvokeVoidAsync("alert", $"❌ {ex.Message}");
        }
        finally
        {
            isSendingSms = false;
            StateHasChanged();
        }
    }

    private string GetAgeBadgeClass(string category) => category switch
    {
        "Normal" => "bg-success",
        "Warning" => "bg-warning text-dark",
        "Critical" => "bg-danger",
        _ => "bg-secondary"
    };

    private async Task ExportToCsv()
    {
        if (report == null || !report.HasData)
        {
            await JsRuntime.InvokeVoidAsync("alert", "داده‌ای برای خروجی وجود ندارد.");
            return;
        }

        var sb = new System.Text.StringBuilder();
        sb.AppendLine("گزارش بدهی‌ها");
        sb.AppendLine($"تاریخ تهیه: {DateTime.Now.ToPersianDate()}");
        if (minAmount.HasValue && minAmount.Value > 0)
            sb.AppendLine($"فیلتر: حداقل {minAmount.Value:N0} تومان");
        sb.AppendLine();

        sb.AppendLine("نام مشتری,تلفن,مبلغ بدهی (تومان),تعداد سفارش,قدیمی‌ترین سفارش,سن بدهی (روز)");
        foreach (var d in SortedDebtors)
        {
            sb.AppendLine($"{d.CustomerName},{d.Phone},{d.TotalDebt:N0},{d.UnpaidOrderCount},{d.OldestOrderDate.ToPersianDate()},{d.DaysSinceOldest}");
        }
        sb.AppendLine();
        sb.AppendLine($"جمع کل,,{report.TotalDebt:N0},,, ");

        var csv = sb.ToString();
        var bytes = System.Text.Encoding.UTF8.GetPreamble()
            .Concat(System.Text.Encoding.UTF8.GetBytes(csv)).ToArray();
        var base64 = Convert.ToBase64String(bytes);
        var fileName = $"DebtsReport_{DateTime.Now:yyyyMMdd_HHmmss}.csv";

        await JsRuntime.InvokeVoidAsync("downloadFileFromBase64", fileName, base64);
    }

    // ===== DTO ها =====
    public class DebtReportDto
    {
        public List<DebtorDto> Debtors { get; set; } = new();
        public decimal TotalDebt { get; set; }
        public int DebtorCount { get; set; }
        public decimal AverageDebt { get; set; }
        public bool HasData { get; set; }
    }

    public class DebtorDto
    {
        public int CustomerId { get; set; }
        public string CustomerName { get; set; } = "";
        public string? Phone { get; set; }
        public decimal TotalDebt { get; set; }
        public int UnpaidOrderCount { get; set; }
        public DateTime OldestOrderDate { get; set; }
        public DateTime? LastOrderDate { get; set; }
        public int DaysSinceOldest { get; set; }
        public string AgeCategory { get; set; } = "Normal";
    }
}