@page "/customers"
@inject HttpClient Http
@inject IJSRuntime JsRuntime

<div class="container-fluid px-2 px-md-3" dir="rtl">
    <h2 class="fs-5 fs-md-4 mb-3">👥 مدیریت مشتریان</h2>

    <button class="btn btn-primary mb-3 btn-sm" @onclick="ShowAddForm">➕ افزودن مشتری جدید</button>

    @if (showForm)
    {
        <div class="card shadow-sm mb-3">
            <div class="card-header bg-success text-white py-2">
                <h5 class="mb-0 fs-6">@(editingCustomer == null ? "افزودن مشتری" : "ویرایش مشتری")</h5>
            </div>
            <div class="card-body p-2 p-md-3">
                <div class="row g-2">
                    <div class="col-12 col-md-6">
                        <label class="form-label small">نام کامل</label>
                        <input class="form-control form-control-sm" @bind="formModel.FullName" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label small">تلفن</label>
                        <input class="form-control form-control-sm" @bind="formModel.Phone" />
                    </div>
                </div>
                <div class="row mt-2 g-2">
                    <div class="col-12">
                        <label class="form-label small">ایمیل</label>
                        <input class="form-control form-control-sm" @bind="formModel.Email" />
                    </div>
                </div>
                <div class="mt-3">
                    <button class="btn btn-success btn-sm" @onclick="SaveCustomer">💾 ذخیره</button>
                    <button class="btn btn-secondary btn-sm" @onclick="CancelForm">❌ انصراف</button>
                </div>
            </div>
        </div>
    }

    <div class="table-responsive">
        <table class="table table-hover table-sm">
            <thead>
                <tr>
                    <th class="small">نام</th>
                    <th class="small">تلفن</th>
                    <th class="small">ایمیل</th>
                    <th class="small">عملیات</th>
                </tr>
            </thead>
            <tbody>
                @if (pagedCustomers == null || !pagedCustomers.Any())
                {
                    <tr><td colspan="4" class="text-center text-muted small py-2">هیچ مشتریی یافت نشد</td></tr>
                }
                else
                {
                    @foreach (var c in pagedCustomers)
                    {
                        <tr>
                            <td class="small">@c.FullName</td>
                            <td class="small">@c.Phone</td>
                            <td class="small">@c.Email</td>
                            <td>
                                <button class="btn btn-sm btn-warning" @onclick="() => EditCustomer(c)">✏️</button>
                                <button class="btn btn-sm btn-danger" @onclick="() => DeleteCustomer(c.CustomerId)">🗑️</button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (totalPages > 1)
    {
        <div class="d-flex justify-content-between align-items-center mt-3">
            <span class="small">صفحه @currentPage از @totalPages</span>
            <div class="d-flex gap-1 flex-wrap">
                <button class="btn btn-sm btn-outline-primary" disabled="@(currentPage == 1)" @onclick="() => GoToPage(currentPage - 1)">قبلی</button>
                @for (int i = 1; i <= totalPages; i++)
                {
                    int pageNumber = i;
                    <button class="btn btn-sm @(pageNumber == currentPage ? "btn-primary" : "btn-outline-secondary")" @onclick="() => GoToPage(pageNumber)">@pageNumber</button>
                }
                <button class="btn btn-sm btn-outline-primary" disabled="@(currentPage == totalPages)" @onclick="() => GoToPage(currentPage + 1)">بعدی</button>
            </div>
        </div>
    }
</div>

@code {
    public class CustomerDto
    {
        public int CustomerId { get; set; }
        public string FullName { get; set; } = "";
        public string Phone { get; set; } = "";
        public string Email { get; set; } = "";
    }

    private List<CustomerDto> allCustomers = new();
    private List<CustomerDto> pagedCustomers = new();
    private int currentPage = 1;
    private int pageSize = 15;
    private int totalPages => (int)Math.Ceiling((double)allCustomers.Count / pageSize);

    private bool showForm = false;
    private CustomerDto? editingCustomer = null;
    private CustomerDto formModel = new();

    protected override async Task OnInitializedAsync() => await LoadCustomers();

    private async Task LoadCustomers()
    {
        try
        {
            allCustomers = await Http.GetFromJsonAsync<List<CustomerDto>>("api/Customers") ?? new();
            UpdatePagedList();
        }
        catch { allCustomers = new(); }
    }

    private void UpdatePagedList()
    {
        pagedCustomers = allCustomers.Skip((currentPage - 1) * pageSize).Take(pageSize).ToList();
    }

    private void GoToPage(int page)
    {
        if (page < 1 || page > totalPages) return;
        currentPage = page;
        UpdatePagedList();
    }

    private void ShowAddForm()
    {
        editingCustomer = null;
        formModel = new();
        showForm = true;
    }

    private void EditCustomer(CustomerDto c)
    {
        editingCustomer = c;
        formModel = new() { CustomerId = c.CustomerId, FullName = c.FullName, Phone = c.Phone, Email = c.Email };
        showForm = true;
    }

    private async Task SaveCustomer()
    {
        try
        {
            HttpResponseMessage response;
            if (editingCustomer == null)
                response = await Http.PostAsJsonAsync("api/Customers", formModel);
            else
                response = await Http.PutAsJsonAsync($"api/Customers/{editingCustomer.CustomerId}", formModel);

            if (response.IsSuccessStatusCode)
            {
                showForm = false;
                await LoadCustomers();
            }
            else
            {
                var content = await response.Content.ReadAsStringAsync();
                await JsRuntime.InvokeVoidAsync("alert", $"❌ خطا: {content}");
            }
        }
        catch (Exception ex)
        {
            await JsRuntime.InvokeVoidAsync("alert", $"❌ خطا: {ex.Message}");
        }
    }

    private void CancelForm()
    {
        showForm = false;
        editingCustomer = null;
        formModel = new();
    }

    private async Task DeleteCustomer(int id)
    {
        var confirmed = await JsRuntime.InvokeAsync<bool>("confirm", "آیا از حذف این مشتری مطمئن هستید؟");
        if (!confirmed) return;

        try
        {
            await Http.DeleteAsync($"api/Customers/{id}");
            await LoadCustomers();
        }
        catch { }
    }
}