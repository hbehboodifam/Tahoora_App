@page "/customers"
@inject HttpClient Http
@inject IJSRuntime JsRuntime
@inject NavigationManager Nav
@implements IDisposable

<div class="container-fluid px-2 px-md-3" dir="rtl">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fs-5 fs-md-4 mb-0">👥 مدیریت مشتریان</h2>
        <button class="btn btn-primary btn-sm" @onclick="ShowAddForm" disabled="@isBusy">
            ➕ افزودن مشتری جدید
        </button>
    </div>

    <!-- ===== جستجو ===== -->
    <div class="mb-3 col-12 col-md-5">
        <div class="input-group input-group-sm">
            <span class="input-group-text bg-white border-end-0">🔍</span>
            <input type="text" class="form-control border-start-0"
                   placeholder="جستجو بر اساس نام یا تلفن..."
                   @bind="searchText"
                   @bind:event="oninput"
                   @onkeyup="OnSearchKeyUp" />
            @if (!string.IsNullOrEmpty(searchText))
            {
                <button class="btn btn-outline-secondary border-start-0" type="button" @onclick="ClearSearch" title="پاک کردن">✖</button>
            }
        </div>
    </div>
    
    <!-- ===== فرم افزودن / ویرایش ===== -->
    @if (showForm)
    {
        <div class="card shadow-sm mb-3 border-success">
            <div class="card-header bg-success text-white py-2">
                <h5 class="mb-0 fs-6">@(editingCustomer == null ? "افزودن مشتری" : "ویرایش مشتری")</h5>
            </div>
            <div class="card-body p-2 p-md-3">
                <div class="row g-2">
                    <div class="col-12 col-md-6">
                        <label class="form-label small">نام کامل <span class="text-danger">*</span></label>
                        <input class="form-control form-control-sm" @bind="formModel.FullName" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label small">تلفن</label>
                        <input type="tel" dir="ltr" class="form-control form-control-sm text-end" @bind="formModel.Phone" placeholder="0912..." />
                    </div>
                </div>
                <div class="row mt-2 g-2">
                    <div class="col-12">
                        <label class="form-label small">ایمیل</label>
                        <input type="email" dir="ltr" class="form-control form-control-sm text-end" @bind="formModel.Email" placeholder="example@domain.com" />
                    </div>
                </div>
                <div class="mt-3">
                    <button class="btn btn-success btn-sm me-1" @onclick="SaveCustomer" disabled="@isBusy">
                        @if (isBusy) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        💾 ذخیره
                    </button>
                    <button class="btn btn-secondary btn-sm" @onclick="CancelForm" disabled="@isBusy">❌ انصراف</button>
                </div>
            </div>
        </div>
    }

    <!-- =================================================== -->
    <!-- 📱 ۱. نمای مخصوص موبایل (کارت‌ها - در screens < 768px) -->
    <!-- =================================================== -->
    <div class="d-block d-md-none">
        @if (isLoading)
        {
            <div class="text-center text-muted py-4 small">در حال دریافت اطلاعات...</div>
        }
        else if (pagedCustomers == null || !pagedCustomers.Any())
        {
            <div class="text-center text-muted py-4 small">هیچ مشتریی یافت نشد</div>
        }
        else
        {
            @foreach (var c in pagedCustomers)
            {
                <div class="card shadow-sm mb-2 border-0 bg-body-tertiary">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="fw-bold text-dark fs-6">@c.FullName</span>
                            <button class="btn btn-sm btn-outline-info px-2 py-1" title="پروفایل" @onclick="() => GoToProfile(c.CustomerId)">
                                👤 پروفایل
                            </button>
                        </div>
                        
                        <div class="row g-1 small border-top pt-2 mt-1">
                            <div class="col-12 text-muted">
                                📞 تلفن: <span dir="ltr" class="text-dark fw-semibold">@(string.IsNullOrWhiteSpace(c.Phone) ? "-" : c.Phone)</span>
                            </div>
                            <div class="col-12 text-muted">
                                ✉️ ایمیل: <span dir="ltr" class="text-dark">@(string.IsNullOrWhiteSpace(c.Email) ? "-" : c.Email)</span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-3 pt-2 border-top">
                            <button class="btn btn-sm btn-outline-warning px-3" @onclick="() => EditCustomer(c)" disabled="@isBusy">✏️ ویرایش</button>
                            <button class="btn btn-sm btn-outline-danger px-3" @onclick="() => DeleteCustomer(c.CustomerId)" disabled="@isBusy">🗑️ حذف</button>
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    <!-- =================================================== -->
    <!-- 🖥️ ۲. نمای مخصوص دسکتاپ و تبلت (جدول - در screens >= 768px) -->
    <!-- =================================================== -->
    <div class="table-responsive d-none d-md-block">
        <table class="table table-hover table-sm align-middle">
            <thead class="table-light">
                <tr>
                    <th class="small">نام</th>
                    <th class="small">تلفن</th>
                    <th class="small">ایمیل</th>
                    <th class="small">عملیات</th>
                </tr>
            </thead>
            <tbody>
            @if (isLoading)
            {
                <tr><td colspan="4" class="text-center text-muted small py-3">در حال دریافت اطلاعات...</td></tr>
            }
            else if (pagedCustomers == null || !pagedCustomers.Any())
            {
                <tr><td colspan="4" class="text-center text-muted small py-3">هیچ مشتریی یافت نشد</td></tr>
            }
            else
            {
                @foreach (var c in pagedCustomers)
                {
                    <tr>
                        <td class="small fw-bold">@c.FullName</td>
                        <td class="small" dir="ltr text-end">@c.Phone</td>
                        <td class="small" dir="ltr text-end">@c.Email</td>
                        <td>
                            <button class="btn btn-sm btn-outline-info me-1" title="پروفایل" @onclick="() => GoToProfile(c.CustomerId)">👤</button>
                            <button class="btn btn-sm btn-outline-warning me-1" @onclick="() => EditCustomer(c)" disabled="@isBusy">✏️</button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteCustomer(c.CustomerId)" disabled="@isBusy">🗑️</button>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>

    <!-- ===== صفحه‌بندی ===== -->
    @if (totalPages > 1)
    {
        <div class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2">
            <span class="small text-muted">صفحه @currentPage از @totalPages (کل: @allCustomers.Count)</span>
            <div class="d-flex gap-1 flex-wrap">
                <button class="btn btn-sm btn-outline-primary" disabled="@(currentPage == 1)" @onclick="() => GoToPage(currentPage - 1)">قبلی</button>
                @for (int i = 1; i <= totalPages; i++)
                {
                    int pageNumber = i;
                    <button class="btn btn-sm @(pageNumber == currentPage ? "btn-primary" : "btn-outline-secondary")" @onclick="() => GoToPage(pageNumber)">@pageNumber</button>
                }
                <button class="btn btn-sm btn-outline-primary" disabled="@(currentPage == totalPages)" @onclick="() => GoToPage(currentPage + 1)">بعدی</button>
            </div>
        </div>
    }
</div>

@code {
    public class CustomerDto
    {
        public int CustomerId { get; set; }
        public string FullName { get; set; } = "";
        public string Phone { get; set; } = "";
        public string Email { get; set; } = "";
    }

    private List<CustomerDto> allCustomers = new();
    private List<CustomerDto> pagedCustomers = new();
    private string searchText = "";
    private System.Threading.Timer? _searchDebounce;
    
    private int currentPage = 1;
    private int pageSize = 15;
    private int totalPages => (int)Math.Ceiling((double)allCustomers.Count / pageSize);

    private bool showForm = false;
    private bool isLoading = false;
    private bool isBusy = false;
    private CustomerDto? editingCustomer = null;
    private CustomerDto formModel = new();

    protected override async Task OnInitializedAsync() => await LoadCustomers();

    private async Task LoadCustomers()
    {
        isLoading = true;
        try
        {
            var url = "api/Customers";
            if (!string.IsNullOrWhiteSpace(searchText))
            {
                url += "?search=" + Uri.EscapeDataString(searchText.Trim());
            }

            allCustomers = await Http.GetFromJsonAsync<List<CustomerDto>>(url) ?? new();
            currentPage = 1;
            UpdatePagedList();
        }
        catch (Exception ex)
        {
            allCustomers = new();
            UpdatePagedList();
            await JsRuntime.InvokeVoidAsync("alert", $"❌ خطا در دریافت اطلاعات: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void UpdatePagedList()
    {
        pagedCustomers = allCustomers.Skip((currentPage - 1) * pageSize).Take(pageSize).ToList();
    }
    
    private void GoToProfile(int customerId)
    {
        Nav.NavigateTo($"/customers/{customerId}/profile");
    }

    private void GoToPage(int page)
    {
        if (page < 1 || page > totalPages) return;
        currentPage = page;
        UpdatePagedList();
    }

    private void ShowAddForm()
    {
        editingCustomer = null;
        formModel = new();
        showForm = true;
    }

    private void EditCustomer(CustomerDto c)
    {
        editingCustomer = c;
        formModel = new() { CustomerId = c.CustomerId, FullName = c.FullName, Phone = c.Phone, Email = c.Email };
        showForm = true;
    }

    private async Task SaveCustomer()
    {
        if (string.IsNullOrWhiteSpace(formModel.FullName))
        {
            await JsRuntime.InvokeVoidAsync("alert", "⚠️ لطفاً نام کامل مشتری را وارد کنید.");
            return;
        }

        isBusy = true;
        try
        {
            HttpResponseMessage response;
            if (editingCustomer == null)
                response = await Http.PostAsJsonAsync("api/Customers", formModel);
            else
                response = await Http.PutAsJsonAsync($"api/Customers/{editingCustomer.CustomerId}", formModel);

            if (response.IsSuccessStatusCode)
            {
                showForm = false;
                await LoadCustomers();
            }
            else
            {
                var content = await response.Content.ReadAsStringAsync();
                await JsRuntime.InvokeVoidAsync("alert", $"❌ خطا: {content}");
            }
        }
        catch (Exception ex)
        {
            await JsRuntime.InvokeVoidAsync("alert", $"❌ خطا: {ex.Message}");
        }
        finally
        {
            isBusy = false;
        }
    }

    private void CancelForm()
    {
        showForm = false;
        editingCustomer = null;
        formModel = new();
    }
    
    private void OnSearchKeyUp(KeyboardEventArgs e)
    {
        _searchDebounce?.Dispose();
        _searchDebounce = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                await LoadCustomers();
                StateHasChanged();
            });
        }, null, 400, System.Threading.Timeout.Infinite);
    }

    private async Task ClearSearch()
    {
        searchText = "";
        await LoadCustomers();
    }

    private async Task DeleteCustomer(int id)
    {
        var confirmed = await JsRuntime.InvokeAsync<bool>("confirm", "آیا از حذف این مشتری مطمئن هستید؟");
        if (!confirmed) return;

        isBusy = true;
        try
        {
            var response = await Http.DeleteAsync($"api/Customers/{id}");
            if (response.IsSuccessStatusCode)
            {
                await LoadCustomers();
            }
            else
            {
                var content = await response.Content.ReadAsStringAsync();
                await JsRuntime.InvokeVoidAsync("alert", $"❌ خطا در حذف: {content}");
            }
        }
        catch (Exception ex)
        {
            await JsRuntime.InvokeVoidAsync("alert", $"❌ خطا: {ex.Message}");
        }
        finally
        {
            isBusy = false;
        }
    }

    public void Dispose()
    {
        _searchDebounce?.Dispose();
    }
}