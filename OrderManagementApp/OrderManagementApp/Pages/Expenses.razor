@page "/expenses"
@inject HttpClient Http
@inject IJSRuntime JsRuntime

<div class="container-fluid px-2 px-md-3" dir="rtl">
    <h2 class="fs-5 fs-md-4 mb-3">💰 مدیریت هزینه‌ها</h2>

    <!-- ===== فیلتر تاریخ شمسی ===== -->
    <div class="card shadow-sm mb-3">
        <div class="card-body p-2 p-md-3">
            <PersianDateRangeFilter
                @bind-FromDate="filterFrom"
                @bind-ToDate="filterTo"
                FromLabel="از تاریخ"
                ToLabel="تا تاریخ"
                ShowApplyButton="true"
                OnApply="ApplyFilter" />
        </div>
    </div>

    <!-- ===== دکمه افزودن + جمع کل ===== -->
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <button class="btn btn-primary btn-sm" @onclick="ShowAddForm">➕ افزودن هزینه جدید</button>
        <div class="alert alert-info py-1 px-3 mb-0 small">
            جمع هزینه‌های فیلترشده: <strong>@filteredTotal.ToString("N0")</strong> تومان
        </div>
    </div>

    <!-- ===== فرم ===== -->
    @if (showForm)
    {
        <div class="card shadow-sm mb-3">
            <div class="card-header bg-primary text-white py-2">
                <h5 class="mb-0 fs-6">@(editingExpense == null ? "افزودن هزینه" : "ویرایش هزینه")</h5>
            </div>
            <div class="card-body p-2 p-md-3">
                <div class="row g-2">
                    <div class="col-6 col-md-3">
                        <label class="form-label small">تاریخ هزینه</label>
                        <InputPersianDatePicker
                            Value="@formDateString"
                            ValueChanged="@((string value) => formDateString = value)"
                            Placeholder="انتخاب تاریخ"
                            CssClass="form-control form-control-sm" />
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label small">دسته‌بندی</label>
                        <select class="form-select form-select-sm" @bind="formModel.CategoryId">
                            <option value="0">-- انتخاب کنید --</option>
                            @foreach (var cat in categories)
                            {
                                <option value="@cat.CategoryId">@cat.CategoryName</option>
                            }
                        </select>
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label small">مبلغ (تومان)</label>
                        <input type="number" class="form-control form-control-sm" @bind="formModel.Amount" />
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label small">نوع</label>
                        <div class="form-check mt-2">
                            <input class="form-check-input" type="checkbox" @bind="formModel.IsRecurring" id="isRec" />
                            <label class="form-check-label small" for="isRec">تکرارشونده (ماهانه/سالانه)</label>
                        </div>
                    </div>
                    <div class="col-12">
                        <label class="form-label small">توضیحات (اختیاری)</label>
                        <input class="form-control form-control-sm" @bind="formModel.Description" placeholder="مثلاً: اجاره کارگاه خرداد" />
                    </div>
                </div>
                <div class="mt-3">
                    <button class="btn btn-success btn-sm" @onclick="SaveExpense">💾 ذخیره</button>
                    <button class="btn btn-secondary btn-sm" @onclick="CancelForm">❌ انصراف</button>
                </div>
            </div>
        </div>
    }

    <!-- ===== جدول ===== -->
    <div class="table-responsive">
        <table class="table table-hover table-sm">
            <thead>
                <tr>
                    <th class="small">تاریخ</th>
                    <th class="small">دسته</th>
                    <th class="small">مبلغ (تومان)</th>
                    <th class="small">نوع</th>
                    <th class="small">توضیحات</th>
                    <th class="small">عملیات</th>
                </tr>
            </thead>
            <tbody>
                @if (pagedExpenses == null || !pagedExpenses.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted small py-2">هیچ هزینه‌ای یافت نشد</td></tr>
                }
                else
                {
                    @foreach (var e in pagedExpenses)
                    {
                        <tr>
                            <td class="small">@ToPersian(e.ExpenseDate)</td>
                            <td class="small">@e.Category?.CategoryName</td>
                            <td class="small">@e.Amount.ToString("N0")</td>
                            <td class="small">
                                @if (e.IsRecurring)
                                {
                                    <span class="badge bg-info">تکرارشونده</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-dark">یک‌باره</span>
                                }
                            </td>
                            <td class="small">@e.Description</td>
                            <td>
                                <button class="btn btn-sm btn-warning" @onclick="() => EditExpense(e)">✏️</button>
                                <button class="btn btn-sm btn-danger" @onclick="() => DeleteExpense(e.ExpenseId)">🗑️</button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- ===== صفحه‌بندی ===== -->
    @if (totalPages > 1)
    {
        <div class="d-flex justify-content-between align-items-center mt-3">
            <span class="small">صفحه @currentPage از @totalPages</span>
            <div class="d-flex gap-1 flex-wrap">
                <button class="btn btn-sm btn-outline-primary" disabled="@(currentPage == 1)" @onclick="() => GoToPage(currentPage - 1)">قبلی</button>
                @for (int i = 1; i <= totalPages; i++)
                {
                    int pageNumber = i;
                    <button class="btn btn-sm @(pageNumber == currentPage ? "btn-primary" : "btn-outline-secondary")" @onclick="() => GoToPage(pageNumber)">@pageNumber</button>
                }
                <button class="btn btn-sm btn-outline-primary" disabled="@(currentPage == totalPages)" @onclick="() => GoToPage(currentPage + 1)">بعدی</button>
            </div>
        </div>
    }
</div>

@code {
    public class ExpenseCategoryDto
    {
        public int CategoryId { get; set; }
        public string CategoryName { get; set; } = "";
        public string? Description { get; set; }
        public bool IsActive { get; set; }
    }

    public class ExpenseDto
    {
        public int ExpenseId { get; set; }
        public DateTime ExpenseDate { get; set; }
        public int CategoryId { get; set; }
        public ExpenseCategoryDto? Category { get; set; }
        public decimal Amount { get; set; }
        public bool IsRecurring { get; set; }
        public string? Description { get; set; }
    }

    private List<ExpenseDto> allExpenses = new();
    private List<ExpenseDto> pagedExpenses = new();
    private List<ExpenseCategoryDto> categories = new();

    private int currentPage = 1;
    private int pageSize = 15;
    private int totalPages => (int)Math.Ceiling((double)allExpenses.Count / pageSize);
    private decimal filteredTotal => allExpenses.Sum(e => e.Amount);

    private DateTime? filterFrom;
    private DateTime? filterTo;

    private bool showForm = false;
    private ExpenseDto? editingExpense = null;
    private ExpenseDto formModel = new();
    private string? formDateString;

    protected override async Task OnInitializedAsync()
    {
        await LoadCategories();
        await LoadExpenses();
    }

    private async Task LoadCategories()
    {
        try
        {
            categories = await Http.GetFromJsonAsync<List<ExpenseCategoryDto>>("api/ExpenseCategories") ?? new();
        }
        catch { categories = new(); }
    }

    private async Task LoadExpenses()
    {
        try
        {
            var url = "api/Expenses";
            var qs = new List<string>();
            if (filterFrom.HasValue) qs.Add($"from={filterFrom.Value:yyyy-MM-dd}");
            if (filterTo.HasValue)   qs.Add($"to={filterTo.Value:yyyy-MM-dd}");
            if (qs.Any()) url += "?" + string.Join("&", qs);

            allExpenses = await Http.GetFromJsonAsync<List<ExpenseDto>>(url) ?? new();
            currentPage = 1;
            UpdatePagedList();
        }
        catch { allExpenses = new(); }
    }

    private void UpdatePagedList()
    {
        pagedExpenses = allExpenses.Skip((currentPage - 1) * pageSize).Take(pageSize).ToList();
    }

    private void GoToPage(int page)
    {
        if (page < 1 || page > totalPages) return;
        currentPage = page;
        UpdatePagedList();
    }

    private async Task ApplyFilter()
    {
        await LoadExpenses();
    }

    private void ShowAddForm()
    {
        editingExpense = null;
        formModel = new() { ExpenseDate = DateTime.Today };
        formDateString = ToPersian(DateTime.Today);
        showForm = true;
    }

    private void EditExpense(ExpenseDto e)
    {
        editingExpense = e;
        formModel = new()
        {
            ExpenseId = e.ExpenseId,
            ExpenseDate = e.ExpenseDate,
            CategoryId = e.CategoryId,
            Amount = e.Amount,
            IsRecurring = e.IsRecurring,
            Description = e.Description
        };
        formDateString = ToPersian(e.ExpenseDate);
        showForm = true;
    }

    private async Task SaveExpense()
    {
        if (string.IsNullOrWhiteSpace(formDateString))
        {
            await JsRuntime.InvokeVoidAsync("alert", "تاریخ را انتخاب کنید");
            return;
        }
        if (formModel.CategoryId == 0)
        {
            await JsRuntime.InvokeVoidAsync("alert", "دسته‌بندی را انتخاب کنید");
            return;
        }
        if (formModel.Amount <= 0)
        {
            await JsRuntime.InvokeVoidAsync("alert", "مبلغ را وارد کنید");
            return;
        }

        var gregorian = ConvertPersianToGregorian(formDateString);
        if (!gregorian.HasValue)
        {
            await JsRuntime.InvokeVoidAsync("alert", "تاریخ نامعتبر است");
            return;
        }
        formModel.ExpenseDate = gregorian.Value;

        try
        {
            HttpResponseMessage response;
            if (editingExpense == null)
                response = await Http.PostAsJsonAsync("api/Expenses", formModel);
            else
                response = await Http.PutAsJsonAsync($"api/Expenses/{editingExpense.ExpenseId}", formModel);

            if (response.IsSuccessStatusCode)
            {
                showForm = false;
                await LoadExpenses();
            }
            else
            {
                var content = await response.Content.ReadAsStringAsync();
                await JsRuntime.InvokeVoidAsync("alert", $"❌ خطا: {content}");
            }
        }
        catch (Exception ex)
        {
            await JsRuntime.InvokeVoidAsync("alert", $"❌ خطا: {ex.Message}");
        }
    }

    private void CancelForm()
    {
        showForm = false;
        editingExpense = null;
        formModel = new();
        formDateString = null;
    }

    private async Task DeleteExpense(int id)
    {
        var confirmed = await JsRuntime.InvokeAsync<bool>("confirm", "آیا از حذف این هزینه مطمئن هستید؟");
        if (!confirmed) return;

        try
        {
            await Http.DeleteAsync($"api/Expenses/{id}");
            await LoadExpenses();
        }
        catch { }
    }

    // ===== تبدیل تاریخ =====
    private string ToPersian(DateTime? dt)
    {
        if (!dt.HasValue) return "";
        var pc = new System.Globalization.PersianCalendar();
        return $"{pc.GetYear(dt.Value):0000}/{pc.GetMonth(dt.Value):00}/{pc.GetDayOfMonth(dt.Value):00}";
    }

    private DateTime? ConvertPersianToGregorian(string? persianDate)
    {
        if (string.IsNullOrEmpty(persianDate)) return null;
        try
        {
            var normalized = persianDate
                .Replace('۰', '0').Replace('۱', '1').Replace('۲', '2').Replace('۳', '3').Replace('۴', '4')
                .Replace('۵', '5').Replace('۶', '6').Replace('۷', '7').Replace('۸', '8').Replace('۹', '9');

            var parts = normalized.Split('/');
            if (parts.Length != 3) return null;
            if (!int.TryParse(parts[0], out int y)) return null;
            if (!int.TryParse(parts[1], out int m)) return null;
            if (!int.TryParse(parts[2], out int d)) return null;

            var pc = new System.Globalization.PersianCalendar();
            return pc.ToDateTime(y, m, d, 0, 0, 0, 0);
        }
        catch { return null; }
    }
}