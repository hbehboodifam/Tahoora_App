@page "/"
@inject HttpClient Http

<div class="container-fluid px-2 px-md-3" dir="rtl">
    <h2 class="fs-5 fs-md-4 mb-3">📊 داشبورد مدیریت</h2>

    <div class="row g-3 mb-3">
        <div class="col-6 col-md-3">
            <label class="form-label small">از تاریخ</label>
            <InputPersianDatePicker 
                Value="@filterFromDateString"
                ValueChanged="@((string value) => { filterFromDateString = value; })"
                Placeholder="انتخاب تاریخ" 
                CssClass="form-control form-control-sm"/>
        </div>
        <div class="col-6 col-md-3">
            <label class="form-label small">تا تاریخ</label>
            <InputPersianDatePicker 
                Value="@filterToDateString"
                ValueChanged="@((string value) => { filterToDateString = value; })"
                Placeholder="انتخاب تاریخ"
                CssClass="form-control form-control-sm"/>
        </div>
        <div class="col-12 col-md-3 d-flex align-items-end">
            <button class="btn btn-primary btn-sm w-100" @onclick="ApplyFilters">🔍 اعمال فیلتر</button>
        </div>
    </div>

    <div class="row g-2 mb-3">
        <div class="col-6 col-md-3">
            <div class="card shadow-sm border-0" style="border-right: 4px solid #3498db !important;">
                <div class="card-body text-center p-2 p-md-3">
                    <h5 class="mb-1">📦</h5>
                    <h6 class="text-muted small mb-0">تعداد سفارشات</h6>
                    <h4 class="mb-0">@totalOrders</h4>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card shadow-sm border-0" style="border-right: 4px solid #2ecc71 !important;">
                <div class="card-body text-center p-2 p-md-3">
                    <h5 class="mb-1">💰</h5>
                    <h6 class="text-muted small mb-0">مجموع فروش</h6>
                    <h4 class="mb-0">@totalRevenue.ToString("N0")</h4>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card shadow-sm border-0" style="border-right: 4px solid #9b59b6 !important;">
                <div class="card-body text-center p-2 p-md-3">
                    <h5 class="mb-1">👥</h5>
                    <h6 class="text-muted small mb-0">تعداد مشتریان</h6>
                    <h4 class="mb-0">@totalCustomers</h4>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card shadow-sm border-0" style="border-right: 4px solid #e74c3c !important;">
                <div class="card-body text-center p-2 p-md-3">
                    <h5 class="mb-1">⏳</h5>
                    <h6 class="text-muted small mb-0">پرداخت نشده</h6>
                    <h4 class="mb-0">@pendingPayments</h4>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-white py-2">
            <h5 class="mb-0 fs-6">📋 آخرین سفارشات</h5>
        </div>
        <div class="card-body p-2">
            <div class="table-responsive">
                <table class="table table-hover table-sm">
                    <thead>
                        <tr>
                            <th class="small">شماره</th>
                            <th class="small">مشتری</th>
                            <th class="small">تاریخ</th>
                            <th class="small">مبلغ</th>
                            <th class="small">وضعیت</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (recentOrders == null || !recentOrders.Any())
                        {
                            <tr><td colspan="5" class="text-center text-muted small py-2">هیچ سفارشی یافت نشد</td></tr>
                        }
                        else
                        {
                            @foreach (var order in recentOrders)
                            {
                                <tr>
                                    <td class="small">#@order.OrderId</td>
                                    <td class="small">@order.CustomerName</td>
                                    <td class="small">@order.OrderDate.ToPersianDate()</td>
                                    <td class="small">@order.TotalAmount.ToString("N0")</td>
                                    <td>
                                        <span class="badge @(order.IsPaid ? "bg-success" : "bg-danger") small">
                                            @(order.IsPaid ? "پرداخت شده" : "پرداخت نشده")
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@code {
    private string? filterFromDateString;
    private string? filterToDateString;
    private DateTime? filterFromDate;
    private DateTime? filterToDate;
    private int totalOrders = 0;
    private decimal totalRevenue = 0;
    private int totalCustomers = 0;
    private int pendingPayments = 0;
    private List<RecentOrder> recentOrders = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData(null, null);
    }

    private async Task ApplyFilters()
    {
        // تبدیل تاریخ شمسی به میلادی
        filterFromDate = ConvertPersianToGregorian(filterFromDateString);
        filterToDate = ConvertPersianToGregorian(filterToDateString);
    
        await LoadData(filterFromDate, filterToDate);
    }

    private DateTime? ConvertPersianToGregorian(string? persianDate)
    {
        if (string.IsNullOrEmpty(persianDate)) return null;
    
        var normalized = persianDate
            .Replace('۰', '0').Replace('۱', '1').Replace('۲', '2').Replace('۳', '3').Replace('۴', '4')
            .Replace('۵', '5').Replace('۶', '6').Replace('۷', '7').Replace('۸', '8').Replace('۹', '9');
        var parts = normalized.Split('/');
    
        if (parts.Length == 3 && 
            int.TryParse(parts[0], out int y) && 
            int.TryParse(parts[1], out int m) && 
            int.TryParse(parts[2], out int d))
        {
            var pc = new System.Globalization.PersianCalendar();
            return pc.ToDateTime(y, m, d, 0, 0, 0, 0);
        }
        return null;
    }

    private async Task LoadData(DateTime? from, DateTime? to)
    {
        try
        {
            var url = "api/dashboard/stats";
            var queryParams = new List<string>();
            if (from.HasValue) queryParams.Add($"from={from.Value:yyyy-MM-dd}");
            if (to.HasValue) queryParams.Add($"to={to.Value:yyyy-MM-dd}");
            if (queryParams.Any()) url += "?" + string.Join("&", queryParams);

            var result = await Http.GetFromJsonAsync<DashboardStats>(url);
            if (result != null)
            {
                totalOrders = result.TotalOrders;
                totalRevenue = result.TotalRevenue;
                totalCustomers = result.TotalCustomers;
                pendingPayments = result.PendingPayments;
                recentOrders = result.RecentOrders ?? new();
            }
        }
        catch { }
    }

    public class DashboardStats
    {
        public int TotalOrders { get; set; }
        public decimal TotalRevenue { get; set; }
        public int TotalCustomers { get; set; }
        public int PendingPayments { get; set; }
        public List<RecentOrder> RecentOrders { get; set; } = new();
    }

    public class RecentOrder
    {
        public int OrderId { get; set; }
        public string CustomerName { get; set; } = "";
        public DateTime OrderDate { get; set; }
        public decimal TotalAmount { get; set; }
        public bool IsPaid { get; set; }
    }
}