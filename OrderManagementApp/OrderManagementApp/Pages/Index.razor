@page "/"
@using ApexCharts
@using OrderManagementApp.Helpers
@inject HttpClient Http

<div class="container-fluid px-2 px-md-3 py-2" dir="rtl">
    <!-- ===== عنوان صفحه ===== -->
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="fs-5 fs-md-4 fw-bold mb-0">📊 داشبورد مدیریت</h2>
    </div>

    <!-- ===== فیلترها ===== -->
    <div class="card shadow-sm border-0 mb-3 bg-light">
        <div class="card-body p-2 p-md-3">
            <div class="row g-2 align-items-end">
                <div class="col-6 col-md-4 col-lg-3">
                    <label class="form-label small fw-semibold text-secondary mb-1">از تاریخ</label>
                    <InputPersianDatePicker
                        Value="@filterFromDateString"
                        ValueChanged="@((string value) => { filterFromDateString = value; })"
                        Placeholder="انتخاب تاریخ"
                        MinDateSetOnToday="false"
                        CssClass="form-control form-control-sm"/>
                </div>
                <div class="col-6 col-md-4 col-lg-3">
                    <label class="form-label small fw-semibold text-secondary mb-1">تا تاریخ</label>
                    <InputPersianDatePicker
                        Value="@filterToDateString"
                        ValueChanged="@((string value) => { filterToDateString = value; })"
                        Placeholder="انتخاب تاریخ"
                        MinDateSetOnToday="false"
                        CssClass="form-control form-control-sm"/>
                </div>
                <div class="col-12 col-md-4 col-lg-3 d-grid">
                    <button class="btn btn-primary btn-sm fw-semibold" @onclick="ApplyFilters">
                        🔍 اعمال فیلتر
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- ===== کارت‌های آماری (KPIs) ===== -->
    <div class="row g-2 mb-3">
        <div class="col-6 col-md-3">
            <div class="card shadow-sm border-0 h-100" style="border-right: 4px solid #3498db !important;">
                <div class="card-body p-2 p-md-3 d-flex flex-column justify-content-center text-center">
                    <div class="fs-4 mb-1">📦</div>
                    <span class="text-muted small fw-semibold mb-1">تعداد سفارشات</span>
                    <h5 class="mb-0 fw-bold fs-6 fs-sm-5 text-truncate">@totalOrders</h5>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card shadow-sm border-0 h-100" style="border-right: 4px solid #2ecc71 !important;">
                <div class="card-body p-2 p-md-3 d-flex flex-column justify-content-center text-center">
                    <div class="fs-4 mb-1">💰</div>
                    <span class="text-muted small fw-semibold mb-1">مجموع فروش (تومان)</span>
                    <h5 class="mb-0 fw-bold fs-6 fs-sm-5 text-success text-truncate">@totalRevenue.ToString("N0")</h5>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card shadow-sm border-0 h-100" style="border-right: 4px solid #9b59b6 !important;">
                <div class="card-body p-2 p-md-3 d-flex flex-column justify-content-center text-center">
                    <div class="fs-4 mb-1">👥</div>
                    <span class="text-muted small fw-semibold mb-1">تعداد مشتریان</span>
                    <h5 class="mb-0 fw-bold fs-6 fs-sm-5 text-truncate">@totalCustomers</h5>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card shadow-sm border-0 h-100" style="border-right: 4px solid #e74c3c !important;">
                <div class="card-body p-2 p-md-3 d-flex flex-column justify-content-center text-center">
                    <div class="fs-4 mb-1">⏳</div>
                    <span class="text-muted small fw-semibold mb-1">پرداخت نشده</span>
                    <h5 class="mb-0 fw-bold fs-6 fs-sm-5 text-danger text-truncate">@pendingPayments</h5>
                </div>
            </div>
        </div>
    </div>

    <!-- ===== نمودارها ===== -->
    @if (chartsLoaded)
    {
        <!-- ===== نمودار فروش و سود ماهانه ===== -->
        @if (monthlyData.Any())
        {
            <div class="card shadow-sm border-0 mb-3">
                <div class="card-header bg-white py-2">
                    <h6 class="mb-0 fw-bold fs-6">📈 فروش و سود ۶ ماه اخیر</h6>
                </div>
                <div class="card-body p-2 p-md-3">
                    <ApexChart TItem="MonthlyPoint"
                               Title=""
                               Options="monthlyChartOptions"
                               Height="280">
                        <ApexPointSeries TItem="MonthlyPoint"
                                         Items="monthlyData"
                                         Name="فروش"
                                         SeriesType="SeriesType.Bar"
                                         XValue="@(e => e.MonthLabel)"
                                         YValue="@(e => e.Sales)" />
                        <ApexPointSeries TItem="MonthlyPoint"
                                         Items="monthlyData"
                                         Name="سود"
                                         SeriesType="SeriesType.Line"
                                         XValue="@(e => e.MonthLabel)"
                                         YValue="@(e => e.Profit)" />
                    </ApexChart>
                </div>
            </div>
        }

        <div class="row g-3 mb-3">
            <!-- ===== پرفروش‌ترین محصولات ===== -->
            @if (topProducts.Any())
            {
                <div class="col-12 col-lg-6">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-header bg-white py-2">
                            <h6 class="mb-0 fw-bold fs-6">🏆 پرفروش‌ترین محصولات (تومان)</h6>
                        </div>
                        <div class="card-body p-2 p-md-3">
                            <ApexChart TItem="TopProductPoint"
                                       Title=""
                                       Options="topProductsChartOptions"
                                       Height="280">
                                <ApexPointSeries TItem="TopProductPoint"
                                                 Items="topProducts"
                                                 Name="فروش"
                                                 SeriesType="SeriesType.Bar"
                                                 XValue="@(e => e.ProductName)"
                                                 YValue="@(e => e.Revenue)" />
                            </ApexChart>
                        </div>
                    </div>
                </div>
            }

            <!-- ===== توزیع هزینه‌ها ===== -->
            @if (expensesByCategory.Any())
            {
                <div class="col-12 col-lg-6">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-header bg-white py-2">
                            <h6 class="mb-0 fw-bold fs-6">💸 توزیع هزینه‌ها بر اساس دسته</h6>
                        </div>
                        <div class="card-body p-2 p-md-3 d-flex justify-content-center align-items-center">
                            <ApexChart TItem="ExpensePoint"
                                       Title=""
                                       Options="expensesChartOptions"
                                       Height="280">
                                <ApexPointSeries TItem="ExpensePoint"
                                                 Items="expensesByCategory"
                                                 Name="هزینه"
                                                 SeriesType="SeriesType.Donut"
                                                 XValue="@(e => e.CategoryName)"
                                                 YValue="@(e => e.Amount)" />
                            </ApexChart>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <!-- ===== آخرین سفارشات ===== -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-bold fs-6">📋 آخرین سفارشات</h6>
        </div>
        <div class="card-body p-2 p-md-3">
            @if (recentOrders == null || !recentOrders.Any())
            {
                <div class="text-center text-muted small py-4">هیچ سفارشی یافت نشد</div>
            }
            else
            {
                <!-- نمای دسکتاپ (جدول) -->
                <div class="table-responsive d-none d-md-block">
                    <table class="table table-hover table-sm align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="small">شماره</th>
                                <th class="small">مشتری</th>
                                <th class="small">تاریخ</th>
                                <th class="small">مبلغ (تومان)</th>
                                <th class="small text-center">وضعیت</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in recentOrders)
                            {
                                <tr>
                                    <td class="small fw-semibold">#@order.OrderId</td>
                                    <td class="small">@order.CustomerName</td>
                                    <td class="small text-muted">@order.OrderDate.ToPersianDate()</td>
                                    <td class="small fw-bold">@order.TotalAmount.ToString("N0")</td>
                                    <td class="text-center">
                                        <span class="badge @(order.IsPaid ? "bg-success" : "bg-danger") px-2 py-1">
                                            @(order.IsPaid ? "پرداخت شده" : "پرداخت نشده")
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- نمای موبایل (کارت‌های فشرده) -->
                <div class="d-block d-md-none">
                    <div class="d-flex flex-column gap-2">
                        @foreach (var order in recentOrders)
                        {
                            <div class="p-2 border rounded bg-white shadow-sm">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="fw-bold small text-primary">#@order.OrderId</span>
                                    <span class="badge @(order.IsPaid ? "bg-success" : "bg-danger")">
                                        @(order.IsPaid ? "پرداخت شده" : "پرداخت نشده")
                                    </span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="fw-semibold small text-dark">@order.CustomerName</span>
                                    <span class="fw-bold small text-dark">@order.TotalAmount.ToString("N0") تومان</span>
                                </div>
                                <div class="text-start">
                                    <small class="text-muted" style="font-size: 0.75rem;">📅 @order.OrderDate.ToPersianDate()</small>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private string? filterFromDateString;
    private string? filterToDateString;
    private DateTime? filterFromDate;
    private DateTime? filterToDate;

    private int totalOrders = 0;
    private decimal totalRevenue = 0;
    private int totalCustomers = 0;
    private int pendingPayments = 0;
    private List<RecentOrder> recentOrders = new();

    // ===== داده‌های نمودار =====
    private List<MonthlyPoint> monthlyData = new();
    private List<TopProductPoint> topProducts = new();
    private List<ExpensePoint> expensesByCategory = new();
    private bool chartsLoaded = false;

    // ===== تنظیمات نمودارها =====
    private ApexChartOptions<MonthlyPoint> monthlyChartOptions = new()
    {
        Chart = new Chart { FontFamily = "IRANSans, Vazir, Tahoma, sans-serif" },
        Colors = new List<string> { "#3498db", "#2ecc71" },
        PlotOptions = new PlotOptions
        {
            Bar = new PlotOptionsBar { ColumnWidth = "50%", BorderRadius = 4 }
        },
        Legend = new Legend { Position = LegendPosition.Top, HorizontalAlign = ApexCharts.Align.Center },
        DataLabels = new DataLabels { Enabled = false },
        Yaxis = new List<YAxis>
        {
            new YAxis
            {
                Labels = new YAxisLabels
                {
                    Formatter = "function(val) { return val.toLocaleString('fa-IR'); }"
                }
            }
        },
        Tooltip = new Tooltip
        {
            Y = new TooltipY
            {
                Formatter = "function(val) { return val.toLocaleString('fa-IR') + ' تومان'; }"
            }
        }
    };

    private ApexChartOptions<TopProductPoint> topProductsChartOptions = new()
    {
        Chart = new Chart { FontFamily = "IRANSans, Vazir, Tahoma, sans-serif" },
        Colors = new List<string> { "#6C63FF" },
        PlotOptions = new PlotOptions
        {
            Bar = new PlotOptionsBar
            {
                Horizontal = true,
                BorderRadius = 4,
                Distributed = true
            }
        },
        DataLabels = new DataLabels { Enabled = false },
        Legend = new Legend { Show = false },
        Xaxis = new XAxis
        {
            Labels = new XAxisLabels { Style = new AxisLabelStyle { FontSize = "10px" } }
        },
        Tooltip = new Tooltip
        {
            Y = new TooltipY
            {
                Formatter = "function(val) { return val.toLocaleString('fa-IR') + ' تومان'; }"
            }
        }
    };

    private ApexChartOptions<ExpensePoint> expensesChartOptions = new()
    {
        Chart = new Chart { FontFamily = "IRANSans, Vazir, Tahoma, sans-serif" },
        Colors = new List<string> { "#e74c3c", "#e67e22", "#f1c40f", "#9b59b6", "#3498db", "#1abc9c", "#95a5a6" },
        Labels = new List<string>(),
        Legend = new Legend { Position = LegendPosition.Bottom, HorizontalAlign = ApexCharts.Align.Center },
        DataLabels = new DataLabels { Enabled = true },
        Tooltip = new Tooltip
        {
            Y = new TooltipY
            {
                Formatter = "function(val) { return val.toLocaleString('fa-IR') + ' تومان'; }"
            }
        }
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadData(null, null);
        await LoadCharts(null, null);
    }

    private async Task ApplyFilters()
    {
        filterFromDate = ConvertPersianToGregorian(filterFromDateString);
        filterToDate = ConvertPersianToGregorian(filterToDateString);

        await LoadData(filterFromDate, filterToDate);
        await LoadCharts(filterFromDate, filterToDate);
    }

    private DateTime? ConvertPersianToGregorian(string? persianDate)
    {
        if (string.IsNullOrEmpty(persianDate)) return null;

        var normalized = persianDate
            .Replace('۰', '0').Replace('۱', '1').Replace('۲', '2').Replace('۳', '3').Replace('۴', '4')
            .Replace('۵', '5').Replace('۶', '6').Replace('۷', '7').Replace('۸', '8').Replace('۹', '9');
        var parts = normalized.Split('/');

        if (parts.Length == 3 &&
            int.TryParse(parts[0], out int y) &&
            int.TryParse(parts[1], out int m) &&
            int.TryParse(parts[2], out int d))
        {
            var pc = new System.Globalization.PersianCalendar();
            return pc.ToDateTime(y, m, d, 0, 0, 0, 0);
        }
        return null;
    }

    private async Task LoadData(DateTime? from, DateTime? to)
    {
        try
        {
            var url = "api/dashboard/stats";
            var queryParams = new List<string>();
            if (from.HasValue) queryParams.Add($"from={from.Value:yyyy-MM-dd}");
            if (to.HasValue)   queryParams.Add($"to={to.Value:yyyy-MM-dd}");
            if (queryParams.Any()) url += "?" + string.Join("&", queryParams);

            var result = await Http.GetFromJsonAsync<DashboardStats>(url);
            if (result != null)
            {
                totalOrders = result.TotalOrders;
                totalRevenue = result.TotalRevenue;
                totalCustomers = result.TotalCustomers;
                pendingPayments = result.PendingPayments;
                recentOrders = result.RecentOrders ?? new();
            }
        }
        catch { }
    }

    private async Task LoadCharts(DateTime? from, DateTime? to)
    {
        try
        {
            var url = "api/dashboard/charts";
            var queryParams = new List<string>();
            if (from.HasValue) queryParams.Add($"from={from.Value:yyyy-MM-dd}");
            if (to.HasValue)   queryParams.Add($"to={to.Value:yyyy-MM-dd}");
            if (queryParams.Any()) url += "?" + string.Join("&", queryParams);

            var result = await Http.GetFromJsonAsync<DashboardCharts>(url);
            if (result != null)
            {
                monthlyData = result.MonthlyData ?? new();
                topProducts = result.TopProducts ?? new();
                expensesByCategory = result.ExpensesByCategory ?? new();
            }
            chartsLoaded = true;
        }
        catch { chartsLoaded = true; }
    }

    // ===== DTO ها =====
    public class DashboardStats
    {
        public int TotalOrders { get; set; }
        public decimal TotalRevenue { get; set; }
        public int TotalCustomers { get; set; }
        public int PendingPayments { get; set; }
        public List<RecentOrder> RecentOrders { get; set; } = new();
    }

    public class RecentOrder
    {
        public int OrderId { get; set; }
        public string CustomerName { get; set; } = "";
        public DateTime OrderDate { get; set; }
        public decimal TotalAmount { get; set; }
        public bool IsPaid { get; set; }
    }

    public class DashboardCharts
    {
        public List<MonthlyPoint> MonthlyData { get; set; } = new();
        public List<TopProductPoint> TopProducts { get; set; } = new();
        public List<ExpensePoint> ExpensesByCategory { get; set; } = new();
    }

    public class MonthlyPoint
    {
        public string MonthLabel { get; set; } = "";
        public decimal Sales { get; set; }
        public decimal Profit { get; set; }
    }

    public class TopProductPoint
    {
        public string ProductName { get; set; } = "";
        public decimal Revenue { get; set; }
    }

    public class ExpensePoint
    {
        public string CategoryName { get; set; } = "";
        public decimal Amount { get; set; }
    }
}