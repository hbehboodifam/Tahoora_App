@page "/orders/create"
@using OrderManagementApp.Helpers
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject IJSRuntime JsRuntime

<div class="container-fluid px-2 px-md-3 pb-5 pb-md-3" dir="rtl">
    
    <!-- هدر اصلی -->
    <div class="d-flex justify-content-between align-items-center my-3">
        <h2 class="fs-5 fs-md-4 mb-0 fw-bold text-primary-dark">➕ ثبت سفارش جدید</h2>
        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="@(() => NavigationManager.NavigateTo("/orders"))">
            ⬅️ بازگشت به لیست
        </button>
    </div>

    <div class="row g-3">
        <!-- ===== بخش سمت راست: انتخاب مشتری و اطلاعات تحویل ===== -->
        <div class="col-12 col-lg-5">
            <!-- کارت انتخاب مشتری -->
            <div class="card shadow-sm border-0 mb-3 rounded-3">
                <div class="card-header bg-primary text-white py-2 rounded-top-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fs-6 fw-bold">👤 انتخاب مشتری</h5>
                    @if (selectedCustomerId > 0)
                    {
                        <span class="badge bg-light text-primary">تایید شده</span>
                    }
                </div>
                <div class="card-body p-2 p-md-3">
                    <div class="mb-2">
                        <input type="text" 
                               class="form-control form-control-md" 
                               placeholder="🔍 جستجوی نام یا تلفن..." 
                               @value="searchTerm" 
                               @oninput="OnSearchTermChanged" />
                    </div>

                    <!-- لیست نتایج جستجو -->
                    <div class="list-group mb-2 border rounded-3 overflow-auto" style="max-height: 180px;">
                        @if (searchResults == null || !searchResults.Any())
                        {
                            <div class="list-group-item text-muted py-2 small text-center">مشتری‌ای یافت نشد.</div>
                        }
                        else
                        {
                            @foreach (var c in searchResults)
                            {
                                <button type="button" 
                                        class="list-group-item list-group-item-action @(selectedCustomerId == c.CustomerId ? "active fw-bold" : "") py-2 px-3"
                                        @onclick="() => SelectCustomer(c)">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span>@c.FullName</span>
                                        <span class="@(selectedCustomerId == c.CustomerId ? "text-white-50" : "text-muted") small">@c.Phone</span>
                                    </div>
                                </button>
                            }
                        }
                    </div>

                    @if (selectedCustomerId > 0)
                    {
                        <div class="alert alert-success py-2 px-3 mb-2 small d-flex justify-content-between align-items-center rounded-3">
                            <span>✅ <strong>@selectedCustomerName</strong></span>
                            <button type="button" class="btn-close btn-sm" @onclick="ClearSelectedCustomer"></button>
                        </div>
                    }

                    <button type="button" class="btn btn-outline-primary btn-sm w-100 py-2 rounded-2" @onclick="ToggleAddCustomerForm">
                        ➕ افزودن مشتری جدید
                    </button>
                </div>
            </div>

            <!-- فرم افزودن مشتری جدید -->
            @if (showAddCustomerForm)
            {
                <div class="card shadow-sm border-success mb-3 rounded-3">
                    <div class="card-header bg-success text-white py-2">
                        <h5 class="mb-0 fs-6 fw-bold">➕ افزودن سریع مشتری</h5>
                    </div>
                    <div class="card-body p-3">
                        <div class="row g-2">
                            <div class="col-12 col-md-6">
                                <label class="form-label small fw-bold">نام کامل *</label>
                                <input class="form-control form-control-md" @bind="newCustomer.FullName" placeholder="مثال: علی محمدی" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label small fw-bold">شماره تلفن</label>
                                <input class="form-control form-control-md" @bind="newCustomer.Phone" placeholder="0912..." />
                            </div>
                            <div class="col-12">
                                <label class="form-label small">ایمیل (اختیاری)</label>
                                <input class="form-control form-control-md" @bind="newCustomer.Email" placeholder="email@example.com" />
                            </div>
                        </div>
                        <div class="mt-3 d-flex gap-2">
                            <button type="button" class="btn btn-success btn-sm px-3" @onclick="SaveNewCustomer" disabled="@isSubmitting">
                                💾 ذخیره مشتری
                            </button>
                            <button type="button" class="btn btn-secondary btn-sm" @onclick="ToggleAddCustomerForm">❌ انصراف</button>
                        </div>
                    </div>
                </div>
            }

            <!-- تنظیمات تحویل و پرداخت -->
            <div class="card shadow-sm border-0 mb-3 rounded-3">
                <div class="card-header bg-secondary text-white py-2 rounded-top-3">
                    <h5 class="mb-0 fs-6 fw-bold">📅 تنظیمات تحویل و پرداخت</h5>
                </div>
                <div class="card-body p-3">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">تاریخ تحویل سفارش</label>
                        <InputPersianDatePicker 
                            Value="@deliveryDateString"
                            ValueChanged="@((string value) => { deliveryDateString = value; })"
                            Placeholder="انتخاب تاریخ تحویل"
                            CssClass="form-control form-control-md" />
                    </div>

                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input" type="checkbox" @bind="isPaid" id="isPaidSwitch" style="width: 2.2em; height: 1.2em;" />
                        <label class="form-check-label me-2 fw-bold small" for="isPaidSwitch">مبلغ تسویه شده است</label>
                    </div>

                    <div class="form-check form-switch mb-1">
                        <input class="form-check-input" type="checkbox" @bind="sendSms" id="sendSmsSwitch" style="width: 2.2em; height: 1.2em;" />
                        <label class="form-check-label me-2 small" for="sendSmsSwitch">📱 ارسال پیامک تأیید به مشتری</label>
                    </div>
                </div>
            </div>
        </div>

        <!-- ===== بخش سمت چپ: افزودن اقلام و اقلام فاکتور ===== -->
        <div class="col-12 col-lg-7">
            <div class="card shadow-sm border-0 mb-3 rounded-3">
                <div class="card-header bg-dark text-white py-2 rounded-top-3">
                    <h5 class="mb-0 fs-6 fw-bold">🛒 انتخاب و افزودن محصولات</h5>
                </div>
                <div class="card-body p-3">
                    <!-- انتخاب محصول -->
                    <div class="mb-2">
                        <label class="form-label small fw-bold">محصول</label>
                        <select class="form-select form-select-md" @bind:get="selectedProductId" @bind:set="OnProductSelected">
                            <option value="0">--- انتخاب محصول ---</option>
                            @foreach (var p in products)
                            {
                                <option value="@p.ProductId">@p.ProductName (@p.UnitPrice.ToString("N0") تومان)</option>
                            }
                        </select>
                    </div>

                    <!-- تعداد و قیمت -->
                    <div class="row g-2 mb-2">
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-bold">مقدار / وزن (کیلوگرم)</label>
                            <input type="number" class="form-control form-control-md" @bind="newQuantity" step="0.1" min="0.1" />
                            
                            <!-- دکمه‌های میانبر لمسی موبایل -->
                            <div class="btn-group w-100 mt-1">
                                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => AdjustQuantity(-0.5m)">0.5-</button>
                                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => AdjustQuantity(0.5m)">0.5+</button>
                                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => AdjustQuantity(1.0m)">1+</button>
                                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => AdjustQuantity(5.0m)">5+</button>
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-bold">قیمت واحد (تومان)</label>
                            <input type="number" class="form-control form-control-md" @bind="newUnitPrice" step="1000" min="0" />
                        </div>
                    </div>

                    <button type="button" class="btn btn-primary w-100 py-2 fw-bold mt-2 rounded-2" @onclick="AddItem">
                        ➕ افزودن به فاکتور
                    </button>
                </div>
            </div>

            <!-- جدول اقلام سفارش -->
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-light py-2 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fs-6 fw-bold">📦 اقلام فاکتور</h5>
                    <span class="badge bg-secondary">@items.Count آیتم</span>
                </div>
                <div class="card-body p-2 p-md-3">
                    <div class="table-responsive-cards">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>محصول</th>
                                    <th>مقدار</th>
                                    <th>قیمت واحد</th>
                                    <th>جمع کل</th>
                                    <th class="text-center">حذف</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (items == null || !items.Any())
                                {
                                    <tr>
                                        <td colspan="5" class="text-muted text-center py-4">
                                            هنوز هیچ محصولی به سفارش اضافه نشده است.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var item in items)
                                    {
                                        <tr>
                                            <td data-label="محصول" class="fw-bold">@item.ProductName</td>
                                            <td data-label="مقدار">@item.Quantity.ToString("N2")</td>
                                            <td data-label="قیمت واحد">@item.UnitPrice.ToString("N0") تومان</td>
                                            <td data-label="جمع کل" class="fw-bold text-success">@item.TotalPrice.ToString("N0") تومان</td>
                                            <td data-label="عملیات" class="text-center">
                                                <button type="button" class="btn btn-outline-danger btn-sm border-0" @onclick="() => RemoveItem(item)">
                                                    🗑️
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (items?.Any() == true)
                    {
                        <div class="d-flex justify-content-between align-items-center bg-light p-3 rounded-3 mt-3 border">
                            <span class="fw-bold fs-6">جمع کل سفارش:</span>
                            <span class="fw-bold fs-5 text-success">@items.Sum(i => i.TotalPrice).ToString("N0") تومان</span>
                        </div>
                    }

                    <!-- دکمه‌های نهایی در دسکتاپ -->
                    <div class="mt-3 d-none d-md-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-secondary px-4" @onclick="@(() => NavigationManager.NavigateTo("/orders"))">
                            انصراف
                        </button>
                        <button type="button" class="btn btn-success px-5 py-2 fw-bold" @onclick="SaveOrder" disabled="@(selectedCustomerId == 0 || !items.Any() || isSubmitting)">
                            @if (isSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                                <span>در حال ثبت...</span>
                            }
                            else
                            {
                                <span>💾 ثبت نهایی سفارش</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ===== نوار چسبیده در پایین صفحه ویژه موبایل (Sticky Mobile Footer) ===== -->
    <div class="d-md-none position-fixed bottom-0 start-0 end-0 bg-white border-top shadow-lg p-2 z-3">
        <div class="d-flex justify-content-between align-items-center mb-2 px-2">
            <span class="small text-muted">جمع کل فاکتور:</span>
            <span class="fw-bold text-success fs-6">@items.Sum(i => i.TotalPrice).ToString("N0") تومان</span>
        </div>
        <button type="button" class="btn btn-success w-100 py-2 fw-bold" @onclick="SaveOrder" disabled="@(selectedCustomerId == 0 || !items.Any() || isSubmitting)">
            @if (isSubmitting)
            {
                <span class="spinner-border spinner-border-sm me-1"></span>
                <span>در حال ثبت...</span>
            }
            else
            {
                <span>💾 ثبت نهایی سفارش</span>
            }
        </button>
    </div>
</div>

@code {
    public class CreateOrderDto
    {
        public int CustomerId { get; set; }
        public DateTime DeliveryDate { get; set; }
        public bool IsPaid { get; set; }
        public List<CreateOrderItemDto> OrderItems { get; set; } = new();
    }

    public class CreateOrderItemDto
    {
        public int ProductId { get; set; }
        public decimal Quantity { get; set; }
        public decimal UnitPrice { get; set; }
    }

    public class CustomerSearchDto
    {
        public int CustomerId { get; set; }
        public string FullName { get; set; } = "";
        public string Phone { get; set; } = "";
    }

    public class ProductDto
    {
        public int ProductId { get; set; }
        public string ProductName { get; set; } = "";
        public decimal UnitPrice { get; set; }
    }

    public class OrderItemDto
    {
        public int ProductId { get; set; }
        public string ProductName { get; set; } = "";
        public decimal Quantity { get; set; }
        public decimal UnitPrice { get; set; }
        public decimal TotalPrice => Quantity * UnitPrice;
    }

    public class NewCustomerDto
    {
        public string FullName { get; set; } = "";
        public string Phone { get; set; } = "";
        public string Email { get; set; } = "";
    }

    private List<CustomerSearchDto> allCustomers = new();
    private List<CustomerSearchDto> searchResults = new();
    private List<ProductDto> products = new();
    private List<OrderItemDto> items = new();

    private string searchTerm = "";
    private int selectedCustomerId = 0;
    private string selectedCustomerName = "";
    private string deliveryDateString = "";
    private DateTime deliveryDate = DateTime.Now.AddDays(3);
    private bool isPaid = false;
    private bool sendSms = true;
    private bool isSubmitting = false;

    private int selectedProductId = 0;
    private decimal newQuantity = 1;
    private decimal newUnitPrice = 0;

    private bool showAddCustomerForm = false;
    private NewCustomerDto newCustomer = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadCustomers();
        await LoadProducts();
    
        var defaultDate = DateTime.Now.AddDays(3);
        var pc = new System.Globalization.PersianCalendar();
        deliveryDateString = $"{pc.GetYear(defaultDate):0000}/{pc.GetMonth(defaultDate):00}/{pc.GetDayOfMonth(defaultDate):00}";
        deliveryDate = defaultDate;
    }

    private async Task LoadCustomers()
    {
        try
        {
            allCustomers = await Http.GetFromJsonAsync<List<CustomerSearchDto>>("api/Customers") ?? new();
            searchResults = allCustomers;
        }
        catch { allCustomers = new(); }
    }

    private async Task LoadProducts()
    {
        try
        {
            products = await Http.GetFromJsonAsync<List<ProductDto>>("api/Products") ?? new();
        }
        catch { products = new(); }
    }

    private void OnSearchTermChanged(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            searchResults = allCustomers;
        }
        else
        {
            var term = searchTerm.Trim();
            searchResults = allCustomers
                .Where(c => c.FullName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                            (c.Phone?.Contains(term) == true))
                .ToList();
        }
        selectedCustomerId = 0;
        selectedCustomerName = "";
    }

    private void SelectCustomer(CustomerSearchDto customer)
    {
        selectedCustomerId = customer.CustomerId;
        selectedCustomerName = customer.FullName;
        searchTerm = customer.FullName;
        searchResults = new List<CustomerSearchDto> { customer };
    }

    private void ClearSelectedCustomer()
    {
        selectedCustomerId = 0;
        selectedCustomerName = "";
        searchTerm = "";
        searchResults = allCustomers;
    }

    private void ToggleAddCustomerForm()
    {
        showAddCustomerForm = !showAddCustomerForm;
        if (!showAddCustomerForm) newCustomer = new();
    }

    private async Task SaveNewCustomer()
    {
        if (string.IsNullOrWhiteSpace(newCustomer.FullName))
        {
            await JsRuntime.InvokeVoidAsync("alert", "لطفاً نام مشتری را وارد کنید.");
            return;
        }

        isSubmitting = true;
        try
        {
            var response = await Http.PostAsJsonAsync("api/Customers", newCustomer);
            if (response.IsSuccessStatusCode)
            {
                await JsRuntime.InvokeVoidAsync("alert", "✅ مشتری با موفقیت افزوده شد!");
                await LoadCustomers();
                var newCustomerData = await response.Content.ReadFromJsonAsync<CustomerSearchDto>();
                if (newCustomerData != null)
                {
                    selectedCustomerId = newCustomerData.CustomerId;
                    selectedCustomerName = newCustomerData.FullName;
                    searchTerm = newCustomerData.FullName;
                    searchResults = new List<CustomerSearchDto> { newCustomerData };
                }
                showAddCustomerForm = false;
                newCustomer = new();
            }
            else
            {
                var content = await response.Content.ReadAsStringAsync();
                await JsRuntime.InvokeVoidAsync("alert", $"❌ خطا: {content}");
            }
        }
        catch (Exception ex)
        {
            await JsRuntime.InvokeVoidAsync("alert", $"❌ خطا: {ex.Message}");
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }

    private void OnProductSelected(int productId)
    {
        selectedProductId = productId;
        if (productId > 0)
        {
            var product = products.FirstOrDefault(p => p.ProductId == productId);
            if (product != null) newUnitPrice = Math.Truncate(product.UnitPrice);
        }
        else newUnitPrice = 0;
    }

    private void AdjustQuantity(decimal delta)
    {
        newQuantity = Math.Max(0.1m, newQuantity + delta);
    }

    private async Task AddItem()
    {
        if (selectedProductId == 0) { await JsRuntime.InvokeVoidAsync("alert", "لطفاً یک محصول انتخاب کنید."); return; }
        if (newQuantity <= 0) { await JsRuntime.InvokeVoidAsync("alert", "تعداد باید بزرگتر از صفر باشد."); return; }
        if (newUnitPrice <= 0) { await JsRuntime.InvokeVoidAsync("alert", "قیمت واحد باید بزرگتر از صفر باشد."); return; }

        var product = products.FirstOrDefault(p => p.ProductId == selectedProductId);
        if (product == null) return;

        if (items.Any(i => i.ProductId == selectedProductId))
        {
            await JsRuntime.InvokeVoidAsync("alert", "این محصول قبلاً به سفارش اضافه شده است.");
            return;
        }

        items.Add(new OrderItemDto
        {
            ProductId = selectedProductId,
            ProductName = product.ProductName,
            Quantity = newQuantity,
            UnitPrice = newUnitPrice
        });

        selectedProductId = 0;
        newQuantity = 1;
        newUnitPrice = 0;
        StateHasChanged();
    }

    private void RemoveItem(OrderItemDto item)
    {
        items.Remove(item);
        StateHasChanged();
    }

    private async Task SaveOrder()
    {
        if (selectedCustomerId == 0) { await JsRuntime.InvokeVoidAsync("alert", "لطفاً یک مشتری انتخاب کنید."); return; }
        if (items.Count == 0) { await JsRuntime.InvokeVoidAsync("alert", "لطفاً حداقل یک محصول به سفارش اضافه کنید."); return; }

        if (!string.IsNullOrEmpty(deliveryDateString))
        {
            var normalized = deliveryDateString
                .Replace('۰', '0').Replace('۱', '1').Replace('۲', '2').Replace('۳', '3').Replace('۴', '4')
                .Replace('۵', '5').Replace('۶', '6').Replace('۷', '7').Replace('۸', '8').Replace('۹', '9');
            var parts = normalized.Split('/');
            if (parts.Length == 3 && int.TryParse(parts[0], out int y) && int.TryParse(parts[1], out int m) && int.TryParse(parts[2], out int d))
            {
                var pc = new System.Globalization.PersianCalendar();
                deliveryDate = pc.ToDateTime(y, m, d, 0, 0, 0, 0);
            }
        }
        
        var payload = new CreateOrderDto
        {
            CustomerId = selectedCustomerId,
            DeliveryDate = deliveryDate,
            IsPaid = isPaid,
            OrderItems = items.Select(i => new CreateOrderItemDto
            {
                ProductId = i.ProductId,
                Quantity = i.Quantity,
                UnitPrice = i.UnitPrice
            }).ToList()
        };

        isSubmitting = true;
        try
        {
            var response = await Http.PostAsJsonAsync("api/Orders", payload);
            var content = await response.Content.ReadAsStringAsync();

            if (response.IsSuccessStatusCode)
            {
                var orderId = await response.Content.ReadFromJsonAsync<int>();

                if (sendSms)
                {
                    var customer = allCustomers.FirstOrDefault(c => c.CustomerId == selectedCustomerId);
                    if (!string.IsNullOrEmpty(customer?.Phone) && customer.Phone.Length >= 11)
                    {
                        var smsResponse = await Http.PostAsync($"api/Orders/{orderId}/send-confirmation", null);
                        if (smsResponse.IsSuccessStatusCode)
                            await JsRuntime.InvokeVoidAsync("alert", "✅ سفارش ثبت و پیامک ارسال شد.");
                        else
                            await JsRuntime.InvokeVoidAsync("alert", "✅ سفارش ثبت شد، اما پیامک ارسال نشد.");
                    }
                }

                // Reset
                items = new();
                selectedCustomerId = 0;
                selectedCustomerName = "";
                searchTerm = "";
                searchResults = allCustomers;
                isPaid = false;
                deliveryDate = DateTime.Now.AddDays(3);

                await JsRuntime.InvokeVoidAsync("alert", $"✅ سفارش شماره {orderId} با موفقیت ثبت شد!");
                NavigationManager.NavigateTo("/orders");
            }
            else
            {
                await JsRuntime.InvokeVoidAsync("alert", $"❌ خطا در ثبت سفارش:\n{content}");
            }
        }
        catch (Exception ex)
        {
            await JsRuntime.InvokeVoidAsync("alert", $"❌ خطا: {ex.Message}");
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }
}