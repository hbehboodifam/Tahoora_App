@page "/orders/create"
@using OrderManagementApp.Helpers
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject IJSRuntime JsRuntime

<div class="container-fluid px-2 px-md-3" dir="rtl">
    <h2 class="fs-5 fs-md-4 mb-3">➕ ثبت سفارش جدید</h2>

    <!-- ===== انتخاب مشتری ===== -->
    <div class="card shadow-sm mb-3">
        <div class="card-header bg-primary text-white py-2">
            <h5 class="mb-0 fs-6">👤 انتخاب مشتری</h5>
        </div>
        <div class="card-body p-2 p-md-3">
            <div class="mb-2">
                <input type="text" class="form-control form-control-sm" placeholder="جستجوی مشتری (نام یا تلفن)..." @value="searchTerm" @oninput="OnSearchTermChanged" />
            </div>
            <div class="list-group mb-2" style="max-height:200px; overflow-y:auto; max-height: 50vh;">
                @if (searchResults == null || !searchResults.Any())
                {
                    <div class="list-group-item text-muted py-2 small">مشتری‌ای یافت نشد.</div>
                }
                else
                {
                    @foreach (var c in searchResults)
                    {
                        <button type="button" class="list-group-item list-group-item-action @(selectedCustomerId == c.CustomerId ? "active" : "") py-2"
                                @onclick="() => SelectCustomer(c)">
                            <div class="d-flex justify-content-between flex-wrap">
                                <span class="fw-bold">@c.FullName</span>
                                <span class="text-muted small">@c.Phone</span>
                            </div>
                        </button>
                    }
                }
            </div>
            @if (selectedCustomerId > 0)
            {
                <div class="alert alert-success py-1 px-2 mb-2 small">✅ <strong>@selectedCustomerName</strong></div>
            }
            <button type="button" class="btn btn-outline-primary btn-sm w-100" @onclick="ToggleAddCustomerForm">
                ➕ افزودن مشتری جدید
            </button>
        </div>
    </div>

    <!-- ===== فرم افزودن مشتری جدید ===== -->
    @if (showAddCustomerForm)
    {
        <div class="card shadow-sm mb-3 border-primary">
            <div class="card-header bg-success text-white py-2">
                <h5 class="mb-0 fs-6">➕ افزودن مشتری جدید</h5>
            </div>
            <div class="card-body p-2 p-md-3">
                <div class="row g-2">
                    <div class="col-12 col-md-6">
                        <label class="form-label small">نام کامل</label>
                        <input class="form-control form-control-sm" @bind="newCustomer.FullName" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label small">تلفن</label>
                        <input class="form-control form-control-sm" @bind="newCustomer.Phone" />
                    </div>
                </div>
                <div class="row mt-2 g-2">
                    <div class="col-12">
                        <label class="form-label small">ایمیل</label>
                        <input class="form-control form-control-sm" @bind="newCustomer.Email" />
                    </div>
                </div>
                <div class="mt-3 d-flex gap-2">
                    <button type="button" class="btn btn-success btn-sm" @onclick="SaveNewCustomer">💾 ذخیره</button>
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="ToggleAddCustomerForm">❌ انصراف</button>
                </div>
            </div>
        </div>
    }

    <!-- ===== اطلاعات سفارش ===== -->
    <div class="card shadow-sm mb-3">
        <div class="card-header bg-info text-white py-2">
            <h5 class="mb-0 fs-6">📋 اطلاعات سفارش</h5>
        </div>
        <div class="card-body p-2 p-md-3">
            <div class="mb-3">
                <label class="form-label small">تاریخ تحویل</label>
                <InputPersianDatePicker 
                    Value="@deliveryDateString"
                    ValueChanged="@((string value) => { deliveryDateString = value; })"
                    Placeholder="انتخاب تاریخ تحویل"
                    CssClass="form-control form-control-sm"/>
            </div>

            <div class="row g-2 mb-3">
                <div class="col-12 col-md-4">
                    <label class="form-label small">محصول</label>
                    <select class="form-select form-select-sm" @bind:get="selectedProductId" @bind:set="OnProductSelected">
                        <option value="0">انتخاب محصول...</option>
                        @foreach (var p in products)
                        {
                            <option value="@p.ProductId">@p.ProductName - @p.UnitPrice.ToString("N0")</option>
                        }
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small">تعداد</label>
                    <input type="number" class="form-control form-control-sm" @bind="newQuantity" step="0.1" min="0.1" />
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small">قیمت واحد</label>
                    <input type="number" class="form-control form-control-sm" @bind="newUnitPrice" step="1" min="0" />
                </div>
                <div class="col-12 col-md-2 d-flex align-items-end">
                    <button type="button" class="btn btn-primary btn-sm w-100" @onclick="AddItem">➕ افزودن</button>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-hover table-sm">
                    <thead>
                        <tr>
                            <th class="small">محصول</th>
                            <th class="small">تعداد</th>
                            <th class="small">قیمت واحد</th>
                            <th class="small">جمع</th>
                            <th class="small">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (items == null || !items.Any())
                        {
                            <tr><td colspan="5" class="text-muted text-center small py-2">هیچ محصولی انتخاب نشده است.</td></tr>
                        }
                        else
                        {
                            @foreach (var item in items)
                            {
                                <tr>
                                    <td class="small">@item.ProductName</td>
                                    <td class="small">@item.Quantity.ToString("N2")</td>
                                    <td class="small">@item.UnitPrice.ToString("N0")</td>
                                    <td class="small">@item.TotalPrice.ToString("N0")</td>
                                    <td>
                                        <button type="button" class="btn btn-sm btn-danger" @onclick="() => RemoveItem(item)">🗑️</button>
                                    </td>
                                </tr>
                            }
                            <tr class="table-info fw-bold">
                                <td colspan="3" class="text-end small">جمع کل:</td>
                                <td class="small">@items.Sum(i => i.TotalPrice).ToString("N0")</td>
                                <td></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" @bind="isPaid" id="isPaid" style="width: 1.2rem; height: 1.2rem;" />
                <label class="form-check-label small" for="isPaid">پرداخت شده</label>
            </div>

            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" @bind="sendSms" id="sendSms" style="width: 1.2rem; height: 1.2rem;" />
                <label class="form-check-label small" for="sendSms">📱 ارسال پیامک تأیید به مشتری</label>
            </div>

            <div class="mt-3 d-flex flex-column flex-md-row gap-2">
                <button type="button" class="btn btn-success" @onclick="SaveOrder" disabled="@(selectedCustomerId == 0 || !items.Any())">
                    💾 ثبت سفارش
                </button>
                <button type="button" class="btn btn-secondary" @onclick="@(() => NavigationManager.NavigateTo("/orders"))">❌ انصراف</button>
            </div>
        </div>
    </div>
</div>

@code {
    public class CreateOrderDto
    {
        public int CustomerId { get; set; }
        public DateTime DeliveryDate { get; set; }
        public bool IsPaid { get; set; }
        public List<CreateOrderItemDto> OrderItems { get; set; } = new();
    }

    public class CreateOrderItemDto
    {
        public int ProductId { get; set; }
        public decimal Quantity { get; set; }
        public decimal UnitPrice { get; set; }
    }

    public class CustomerSearchDto
    {
        public int CustomerId { get; set; }
        public string FullName { get; set; } = "";
        public string Phone { get; set; } = "";
    }

    public class ProductDto
    {
        public int ProductId { get; set; }
        public string ProductName { get; set; } = "";
        public decimal UnitPrice { get; set; }
    }

    public class OrderItemDto
    {
        public int ProductId { get; set; }
        public string ProductName { get; set; } = "";
        public decimal Quantity { get; set; }
        public decimal UnitPrice { get; set; }
        public decimal TotalPrice => Quantity * UnitPrice;
    }

    public class NewCustomerDto
    {
        public string FullName { get; set; } = "";
        public string Phone { get; set; } = "";
        public string Email { get; set; } = "";
    }

    private List<CustomerSearchDto> allCustomers = new();
    private List<CustomerSearchDto> searchResults = new();
    private List<ProductDto> products = new();
    private List<OrderItemDto> items = new();

    private string searchTerm = "";
    private int selectedCustomerId = 0;
    private string selectedCustomerName = "";
    private string deliveryDateString = "";
    private DateTime deliveryDate = DateTime.Now.AddDays(3);
    private bool isPaid = false;
    private bool sendSms = true;

    private int selectedProductId = 0;
    private decimal newQuantity = 1;
    private decimal newUnitPrice = 0;

    private bool showAddCustomerForm = false;
    private NewCustomerDto newCustomer = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadCustomers();
        await LoadProducts();
    
        // تنظیم تاریخ پیش‌فرض به شمسی
        var defaultDate = DateTime.Now.AddDays(3);
        var pc = new System.Globalization.PersianCalendar();
        deliveryDateString = $"{pc.GetYear(defaultDate):0000}/{pc.GetMonth(defaultDate):00}/{pc.GetDayOfMonth(defaultDate):00}";
        deliveryDate = defaultDate;
    }

    private async Task LoadCustomers()
    {
        try
        {
            allCustomers = await Http.GetFromJsonAsync<List<CustomerSearchDto>>("api/Customers") ?? new();
            searchResults = allCustomers;
        }
        catch { allCustomers = new(); }
    }

    private async Task LoadProducts()
    {
        try
        {
            products = await Http.GetFromJsonAsync<List<ProductDto>>("api/Products") ?? new();
        }
        catch { products = new(); }
    }

    private void OnSearchTermChanged(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            searchResults = allCustomers;
        }
        else
        {
            var term = searchTerm.Trim();
            searchResults = allCustomers
                .Where(c => c.FullName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                            (c.Phone?.Contains(term) == true))
                .ToList();
        }
        selectedCustomerId = 0;
        selectedCustomerName = "";
    }

    private void SelectCustomer(CustomerSearchDto customer)
    {
        selectedCustomerId = customer.CustomerId;
        selectedCustomerName = customer.FullName;
        searchTerm = customer.FullName;
        searchResults = new List<CustomerSearchDto> { customer };
    }

    private void ToggleAddCustomerForm()
    {
        showAddCustomerForm = !showAddCustomerForm;
        if (!showAddCustomerForm) newCustomer = new();
    }

    private async Task SaveNewCustomer()
    {
        if (string.IsNullOrWhiteSpace(newCustomer.FullName))
        {
            await JsRuntime.InvokeVoidAsync("alert", "لطفاً نام مشتری را وارد کنید.");
            return;
        }

        try
        {
            var response = await Http.PostAsJsonAsync("api/Customers", newCustomer);
            if (response.IsSuccessStatusCode)
            {
                await JsRuntime.InvokeVoidAsync("alert", "✅ مشتری با موفقیت افزوده شد!");
                await LoadCustomers();
                var newCustomerData = await response.Content.ReadFromJsonAsync<CustomerSearchDto>();
                if (newCustomerData != null)
                {
                    selectedCustomerId = newCustomerData.CustomerId;
                    selectedCustomerName = newCustomerData.FullName;
                    searchTerm = newCustomerData.FullName;
                    searchResults = new List<CustomerSearchDto> { newCustomerData };
                }
                showAddCustomerForm = false;
                newCustomer = new();
                StateHasChanged();
            }
            else
            {
                var content = await response.Content.ReadAsStringAsync();
                await JsRuntime.InvokeVoidAsync("alert", $"❌ خطا: {content}");
            }
        }
        catch (Exception ex)
        {
            await JsRuntime.InvokeVoidAsync("alert", $"❌ خطا: {ex.Message}");
        }
    }

    private void OnProductSelected(int productId)
    {
        selectedProductId = productId;
        if (productId > 0)
        {
            var product = products.FirstOrDefault(p => p.ProductId == productId);
            if (product != null) newUnitPrice = Math.Truncate(product.UnitPrice);
        }
        else newUnitPrice = 0;
    }

    private async Task AddItem()
    {
        if (selectedProductId == 0) { await JsRuntime.InvokeVoidAsync("alert", "لطفاً یک محصول انتخاب کنید."); return; }
        if (newQuantity <= 0) { await JsRuntime.InvokeVoidAsync("alert", "تعداد باید بزرگتر از صفر باشد."); return; }
        if (newUnitPrice <= 0) { await JsRuntime.InvokeVoidAsync("alert", "قیمت واحد باید بزرگتر از صفر باشد."); return; }

        var product = products.FirstOrDefault(p => p.ProductId == selectedProductId);
        if (product == null) return;

        if (items.Any(i => i.ProductId == selectedProductId))
        {
            await JsRuntime.InvokeVoidAsync("alert", "این محصول قبلاً به سفارش اضافه شده است.");
            return;
        }

        items.Add(new OrderItemDto
        {
            ProductId = selectedProductId,
            ProductName = product.ProductName,
            Quantity = newQuantity,
            UnitPrice = newUnitPrice
        });

        selectedProductId = 0;
        newQuantity = 1;
        newUnitPrice = 0;
        StateHasChanged();
    }

    private void RemoveItem(OrderItemDto item)
    {
        items.Remove(item);
        StateHasChanged();
    }

    private async Task SaveOrder()
    {
        if (selectedCustomerId == 0) { await JsRuntime.InvokeVoidAsync("alert", "لطفاً یک مشتری انتخاب کنید."); return; }
        if (items.Count == 0) { await JsRuntime.InvokeVoidAsync("alert", "لطفاً حداقل یک محصول به سفارش اضافه کنید."); return; }

        // تبدیل تاریخ شمسی به میلادی
        if (!string.IsNullOrEmpty(deliveryDateString))
        {
            var normalized = deliveryDateString
                .Replace('۰', '0').Replace('۱', '1').Replace('۲', '2').Replace('۳', '3').Replace('۴', '4')
                .Replace('۵', '5').Replace('۶', '6').Replace('۷', '7').Replace('۸', '8').Replace('۹', '9');
            var parts = normalized.Split('/');
            if (parts.Length == 3 && int.TryParse(parts[0], out int y) && int.TryParse(parts[1], out int m) && int.TryParse(parts[2], out int d))
            {
                var pc = new System.Globalization.PersianCalendar();
                deliveryDate = pc.ToDateTime(y, m, d, 0, 0, 0, 0);
            }
        }
        
        var payload = new CreateOrderDto
        {
            CustomerId = selectedCustomerId,
            DeliveryDate = deliveryDate,
            IsPaid = isPaid,
            OrderItems = items.Select(i => new CreateOrderItemDto
            {
                ProductId = i.ProductId,
                Quantity = i.Quantity,
                UnitPrice = i.UnitPrice
            }).ToList()
        };

        try
        {
            var response = await Http.PostAsJsonAsync("api/Orders", payload);
            var content = await response.Content.ReadAsStringAsync();

            if (response.IsSuccessStatusCode)
            {
                var orderId = await response.Content.ReadFromJsonAsync<int>();

                // ارسال پیامک
                if (sendSms)
                {
                    var customer = allCustomers.FirstOrDefault(c => c.CustomerId == selectedCustomerId);
                    if (!string.IsNullOrEmpty(customer?.Phone) && customer.Phone.Length >= 11)
                    {
                        var smsResponse = await Http.PostAsync($"api/Orders/{orderId}/send-confirmation", null);
                        if (smsResponse.IsSuccessStatusCode)
                            await JsRuntime.InvokeVoidAsync("alert", "✅ سفارش ثبت و پیامک ارسال شد.");
                        else
                            await JsRuntime.InvokeVoidAsync("alert", "✅ سفارش ثبت شد، اما پیامک ارسال نشد.");
                    }
                }

                // Reset
                items = new();
                selectedCustomerId = 0;
                selectedCustomerName = "";
                searchTerm = "";
                searchResults = allCustomers;
                isPaid = false;
                deliveryDate = DateTime.Now.AddDays(3);
                StateHasChanged();

                await JsRuntime.InvokeVoidAsync("alert", $"✅ سفارش شماره {orderId} با موفقیت ثبت شد!");
            }
            else
            {
                await JsRuntime.InvokeVoidAsync("alert", $"❌ خطا در ثبت سفارش:\n{content}");
            }
        }
        catch (Exception ex)
        {
            await JsRuntime.InvokeVoidAsync("alert", $"❌ خطا: {ex.Message}");
        }
    }
}