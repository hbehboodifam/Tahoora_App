@page "/orders"
@using OrderManagementApp.Helpers
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject IJSRuntime JsRuntime

<div class="container-fluid px-2 px-md-3" dir="rtl">
    <h2 class="fs-5 fs-md-4 mb-3">📋 مدیریت سفارشات</h2>

    <!-- فیلترها -->
    <div class="row g-2 mb-3">
        <div class="col-12 col-md-3">
            <label class="form-label small">مشتری</label>
            <select class="form-select form-select-sm" @bind="filterCustomerId">
                <option value="0">همه مشتریان</option>
                @foreach (var c in customers)
                {
                    <option value="@c.CustomerId">@c.FullName</option>
                }
            </select>
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label small">از تاریخ</label>
            <InputPersianDatePicker 
                Value="@filterFromDateString"
                ValueChanged="@((string value) => { filterFromDateString = value; })"
                Placeholder="انتخاب"
                CssClass="form-control form-control-sm"/>
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label small">تا تاریخ</label>
            <InputPersianDatePicker 
                Value="@filterToDateString"
                ValueChanged="@((string value) => { filterToDateString = value; })"
                Placeholder="انتخاب"
                CssClass="form-control form-control-sm"/>
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label small">وضعیت پرداخت</label>
            <select class="form-select form-select-sm" @bind="filterPaymentStatus">
                <option value="all">همه</option>
                <option value="paid">پرداخت شده</option>
                <option value="unpaid">پرداخت نشده</option>
            </select>
        </div>
        <div class="col-6 col-md-2 d-flex align-items-end">
            <button class="btn btn-primary btn-sm w-100" @onclick="ApplyFilters">🔍 اعمال فیلتر</button>
        </div>
    </div>

    <!-- نمایش در دسکتاپ -->
    <div class="table-responsive d-none d-md-block">
        <table class="table table-hover table-sm">
            <thead>
                <tr>
                    <th class="small">شماره</th>
                    <th class="small">مشتری</th>
                    <th class="small">تاریخ سفارش</th>
                    <th class="small">تاریخ تحویل</th>
                    <th class="small">مبلغ</th>
                    <th class="small">وضعیت</th>
                    <th class="small">عملیات</th>
                </tr>
            </thead>
            <tbody>
                @if (pagedOrders == null || !pagedOrders.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted small py-2">هیچ سفارشی یافت نشد</td></tr>
                }
                else
                {
                    @foreach (var o in pagedOrders)
                    {
                        <tr>
                            <td class="small">#@o.OrderId</td>
                            <td class="small">@o.CustomerName</td>
                            <td class="small">@o.OrderDate.ToPersianDate()</td>
                            <td class="small">@o.DeliveryDate.ToPersianDate()</td>
                            <td class="small">@o.TotalAmount.ToString("N0")</td>
                            <td>
                                <span class="badge @(o.IsPaid ? "bg-success" : "bg-danger") small">
                                    @(o.IsPaid ? "پرداخت شده" : "پرداخت نشده")
                                </span>
                            </td>
                            <td>
                                <div class="d-flex flex-nowrap gap-1">
                                    <button class="btn btn-sm btn-info" @onclick="() => ViewOrder(o.OrderId)">👁️</button>
                                    <button class="btn btn-sm btn-warning" @onclick="() => EditOrder(o.OrderId)">✏️</button>
                                    <button class="btn btn-sm btn-danger" @onclick="() => DeleteOrder(o.OrderId)">🗑️</button>
                                    <button class="btn btn-sm @(o.IsPaid ? "btn-success" : "btn-secondary")" @onclick="() => TogglePayment(o.OrderId)">@(o.IsPaid ? "✅" : "⏳")</button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- نمایش کارتی در موبایل -->
    <div class="d-md-none">
        @if (pagedOrders == null || !pagedOrders.Any())
        {
            <div class="text-center text-muted small py-3">هیچ سفارشی یافت نشد</div>
        }
        else
        {
            @foreach (var o in pagedOrders)
            {
                <div class="card shadow-sm mb-2">
                    <div class="card-body p-2">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <span class="badge bg-secondary small">#@o.OrderId</span>
                                <span class="fw-bold me-1 small">@o.CustomerName</span>
                            </div>
                            <span class="badge @(o.IsPaid ? "bg-success" : "bg-danger") small">
                                @(o.IsPaid ? "پرداخت شده" : "پرداخت نشده")
                            </span>
                        </div>
                        <div class="d-flex justify-content-between small text-muted mt-1">
                            <span>📅 @o.OrderDate.ToPersianDate()</span>
                            <span>📦 @o.DeliveryDate.ToPersianDate()</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <span class="fw-bold text-primary small">@o.TotalAmount.ToString("N0") تومان</span>
                            <div class="d-flex gap-1">
                                <button class="btn btn-sm btn-info" @onclick="() => ViewOrder(o.OrderId)">👁️</button>
                                <button class="btn btn-sm btn-warning" @onclick="() => EditOrder(o.OrderId)">✏️</button>
                                <button class="btn btn-sm btn-danger" @onclick="() => DeleteOrder(o.OrderId)">🗑️</button>
                                <button class="btn btn-sm @(o.IsPaid ? "btn-success" : "btn-secondary")" @onclick="() => TogglePayment(o.OrderId)">@(o.IsPaid ? "✅" : "⏳")</button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    @if (totalPages > 1)
    {
        <div class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2">
            <span class="small">صفحه @currentPage از @totalPages</span>
            <div class="d-flex gap-1 flex-wrap">
                <button class="btn btn-sm btn-outline-primary" disabled="@(currentPage == 1)" @onclick="() => GoToPage(currentPage - 1)">قبلی</button>
                @for (int i = 1; i <= totalPages; i++)
                {
                    int pageNumber = i;
                    <button class="btn btn-sm @(pageNumber == currentPage ? "btn-primary" : "btn-outline-secondary")" @onclick="() => GoToPage(pageNumber)">@pageNumber</button>
                }
                <button class="btn btn-sm btn-outline-primary" disabled="@(currentPage == totalPages)" @onclick="() => GoToPage(currentPage + 1)">بعدی</button>
            </div>
        </div>
    }

    <div class="row g-2 mt-3">
        <div class="col-6 col-md-3"><div class="card bg-light"><div class="card-body text-center p-2"><h6 class="small mb-0">تعداد کل</h6><h5 class="mb-0">@totalOrders</h5></div></div></div>
        <div class="col-6 col-md-3"><div class="card bg-light"><div class="card-body text-center p-2"><h6 class="small mb-0">مجموع فروش</h6><h5 class="mb-0">@totalRevenue.ToString("N0")</h5></div></div></div>
        <div class="col-6 col-md-3"><div class="card bg-light"><div class="card-body text-center p-2"><h6 class="small mb-0">پرداخت شده</h6><h5 class="mb-0">@paidCount</h5></div></div></div>
        <div class="col-6 col-md-3"><div class="card bg-light"><div class="card-body text-center p-2"><h6 class="small mb-0">پرداخت نشده</h6><h5 class="mb-0">@unpaidCount</h5></div></div></div>
    </div>
</div>

@code {
    public class CustomerDto
    {
        public int CustomerId { get; set; }
        public string FullName { get; set; } = "";
    }

    public class OrderListModel
    {
        public int OrderId { get; set; }
        public string CustomerName { get; set; } = "";
        public DateTime OrderDate { get; set; }
        public DateTime DeliveryDate { get; set; }
        public decimal TotalAmount { get; set; }
        public bool IsPaid { get; set; }
        public DateTime? PaymentDate { get; set; }
        public string? Notes { get; set; }
    }

    private List<CustomerDto> customers = new();
    private List<OrderListModel> allOrders = new();
    private List<OrderListModel> pagedOrders = new();
    private int currentPage = 1;
    private int pageSize = 15;
    private int filterCustomerId = 0;
    private string? filterFromDateString;
    private string? filterToDateString;
    private DateTime? filterFromDate;
    private DateTime? filterToDate;
    private string filterPaymentStatus = "all";

    private int totalOrders => allOrders?.Count ?? 0;
    private decimal totalRevenue => allOrders?.Sum(o => o.TotalAmount) ?? 0;
    private int paidCount => allOrders?.Count(o => o.IsPaid) ?? 0;
    private int unpaidCount => allOrders?.Count(o => !o.IsPaid) ?? 0;
    private int totalPages => (int)Math.Ceiling((double)allOrders.Count / pageSize);

    protected override async Task OnInitializedAsync()
    {
        await LoadCustomers();
        await LoadOrders();
    }

    private async Task LoadCustomers()
    {
        try { customers = await Http.GetFromJsonAsync<List<CustomerDto>>("api/Customers") ?? new(); }
        catch { }
    }

    private async Task LoadOrders()
    {
        try
        {
            var url = "api/Orders";
            var queryParams = new List<string>();

            if (filterCustomerId > 0) queryParams.Add($"customerId={filterCustomerId}");
            if (filterFromDate.HasValue) queryParams.Add($"from={filterFromDate.Value:yyyy-MM-dd}");
            if (filterToDate.HasValue) queryParams.Add($"to={filterToDate.Value:yyyy-MM-dd}");
            if (filterPaymentStatus != "all") queryParams.Add($"isPaid={filterPaymentStatus == "paid"}");

            if (queryParams.Any()) url += "?" + string.Join("&", queryParams);

            allOrders = await Http.GetFromJsonAsync<List<OrderListModel>>(url) ?? new();
            UpdatePagedList();
        }
        catch { allOrders = new(); }
    }

    private void UpdatePagedList()
    {
        pagedOrders = allOrders.Skip((currentPage - 1) * pageSize).Take(pageSize).ToList();
    }

    private void GoToPage(int page)
    {
        if (page < 1 || page > totalPages) return;
        currentPage = page;
        UpdatePagedList();
    }

    private async Task ApplyFilters()
    {
        filterFromDate = ConvertPersianToGregorian(filterFromDateString);
        filterToDate = ConvertPersianToGregorian(filterToDateString);
        await LoadOrders();
    }

    private DateTime? ConvertPersianToGregorian(string? persianDate)
    {
        if (string.IsNullOrEmpty(persianDate)) return null;
    
        var normalized = persianDate
            .Replace('۰', '0').Replace('۱', '1').Replace('۲', '2').Replace('۳', '3').Replace('۴', '4')
            .Replace('۵', '5').Replace('۶', '6').Replace('۷', '7').Replace('۸', '8').Replace('۹', '9');
        var parts = normalized.Split('/');
    
        if (parts.Length == 3 && 
            int.TryParse(parts[0], out int y) && 
            int.TryParse(parts[1], out int m) && 
            int.TryParse(parts[2], out int d))
        {
            var pc = new System.Globalization.PersianCalendar();
            return pc.ToDateTime(y, m, d, 0, 0, 0, 0);
        }
        return null;
    }
    private void ViewOrder(int id) => NavigationManager.NavigateTo($"/orders/details/{id}");
    private void EditOrder(int id) => NavigationManager.NavigateTo($"/orders/edit/{id}");

    private async Task DeleteOrder(int id)
    {
        var confirmed = await JsRuntime.InvokeAsync<bool>("confirm", "آیا از حذف این سفارش مطمئن هستید؟");
        if (!confirmed) return;

        try
        {
            await Http.DeleteAsync($"api/Orders/{id}");
            await LoadOrders();
        }
        catch { }
    }

    private async Task TogglePayment(int orderId)
    {
        var order = allOrders.FirstOrDefault(o => o.OrderId == orderId);
        if (order == null) return;

        var newStatus = !order.IsPaid;
        var statusText = newStatus ? "پرداخت شده" : "پرداخت نشده";

        var confirm = await JsRuntime.InvokeAsync<bool>("confirm", $"آیا از تغییر وضعیت به '{statusText}' مطمئن هستید؟");
        if (!confirm) return;

        try
        {
            var response = await Http.PutAsJsonAsync($"api/Orders/{orderId}/toggle-payment", new { IsPaid = newStatus });
            if (response.IsSuccessStatusCode)
            {
                order.IsPaid = newStatus;
                StateHasChanged();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                await JsRuntime.InvokeVoidAsync("alert", $"❌ خطا: {error}");
            }
        }
        catch (Exception ex)
        {
            await JsRuntime.InvokeVoidAsync("alert", $"❌ خطا: {ex.Message}");
        }
    }
}