@page "/orders"
@using OrderManagementApp.Helpers
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject IJSRuntime JsRuntime

<div class="container-fluid px-2 px-md-3 pb-4" dir="rtl">
    
    <!-- هدر اصلی و دکمه اقدام سریع -->
    <div class="d-flex justify-content-between align-items-center my-3 flex-wrap gap-2">
        <h2 class="fs-5 fs-md-4 mb-0 fw-bold text-primary-dark">📋 مدیریت سفارشات</h2>
        <button class="btn btn-primary btn-sm px-3 py-2 fw-bold rounded-2" @onclick='() => NavigationManager.NavigateTo("/orders/create")'>
            ➕ ثبت سفارش جدید
        </button>
    </div>

    <!-- خلاصه آمار و KPIها -->
    <div class="row g-2 mb-3">
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm bg-white rounded-3">
                <div class="card-body p-2 p-md-3 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small d-block mb-1">تعداد کل سفارشات</span>
                        <h5 class="fw-bold mb-0 text-dark">@totalOrders</h5>
                    </div>
                    <div class="fs-3 text-primary opacity-75">📦</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm bg-white rounded-3">
                <div class="card-body p-2 p-md-3 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small d-block mb-1">مجموع فروش</span>
                        <h5 class="fw-bold mb-0 text-success fs-6 fs-md-5">@totalRevenue.ToString("N0") <small class="fs-6">تومان</small></h5>
                    </div>
                    <div class="fs-3 text-success opacity-75">💰</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm bg-white rounded-3">
                <div class="card-body p-2 p-md-3 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small d-block mb-1">تسویه شده</span>
                        <h5 class="fw-bold mb-0 text-primary">@paidCount</h5>
                    </div>
                    <div class="fs-3 text-primary opacity-75">✅</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm bg-white rounded-3">
                <div class="card-body p-2 p-md-3 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small d-block mb-1">تسویه‌نشده</span>
                        <h5 class="fw-bold mb-0 text-danger">@unpaidCount</h5>
                    </div>
                    <div class="fs-3 text-danger opacity-75">⏳</div>
                </div>
            </div>
        </div>
    </div>

    <!-- بخش فیلترها -->
    <div class="card border-0 shadow-sm mb-3 rounded-3 bg-light">
        <div class="card-body p-2 p-md-3">
            <div class="row g-2">
                <div class="col-12 col-md-3">
                    <label class="form-label small fw-bold">مشتری</label>
                    <select class="form-select form-select-sm" @bind="filterCustomerId">
                        <option value="0">همه مشتریان</option>
                        @foreach (var c in customers)
                        {
                            <option value="@c.CustomerId">@c.FullName</option>
                        }
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small fw-bold">از تاریخ</label>
                    <InputPersianDatePicker 
                        Value="@filterFromDateString"
                        ValueChanged="@((string value) => { filterFromDateString = value; })"
                        Placeholder="انتخاب"
                        
                        CssClass="form-control form-control-sm"/>
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small fw-bold">تا تاریخ</label>
                    <InputPersianDatePicker 
                        Value="@filterToDateString"
                        ValueChanged="@((string value) => { filterToDateString = value; })"
                        Placeholder="انتخاب"
                        CssClass="form-control form-control-sm"/>
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small fw-bold">وضعیت پرداخت</label>
                    <select class="form-select form-select-sm" @bind="filterPaymentStatus">
                        <option value="all">همه</option>
                        <option value="paid">پرداخت شده</option>
                        <option value="unpaid">پرداخت نشده</option>
                    </select>
                </div>
                <div class="col-6 col-md-3 d-flex align-items-end gap-1">
                    <button class="btn btn-primary btn-sm w-100 fw-bold" @onclick="ApplyFilters">🔍 فیلتر</button>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="ResetFilters" title="پاک‌سازی فیلترها">🔄</button>
                </div>
            </div>
        </div>
    </div>

    <!-- نمایش دسکتاپ (جدول) -->
    <div class="card border-0 shadow-sm rounded-3 d-none d-md-block">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light border-bottom">
                        <tr>
                            <th class="py-2 px-3 small">شماره</th>
                            <th class="py-2 px-3 small">مشتری</th>
                            <th class="py-2 px-3 small">تاریخ ثبت</th>
                            <th class="py-2 px-3 small">تاریخ تحویل</th>
                            <th class="py-2 px-3 small">مبلغ کل</th>
                            <th class="py-2 px-3 small">وضعیت</th>
                            <th class="py-2 px-3 small text-center">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (pagedOrders == null || !pagedOrders.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted small py-4">
                                    هیچ سفارشی مطابق فیلترهای انتخابی یافت نشد.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var o in pagedOrders)
                            {
                                <tr>
                                    <td class="px-3 fw-bold text-secondary">#@o.OrderId</td>
                                    <td class="px-3 fw-bold">@o.CustomerName</td>
                                    <td class="px-3 small text-muted">@o.OrderDate.ToPersianDate()</td>
                                    <td class="px-3 small text-muted">@o.DeliveryDate.ToPersianDate()</td>
                                    <td class="px-3 fw-bold text-success">@o.TotalAmount.ToString("N0") تومان</td>
                                    <td class="px-3">
                                        <span class="badge @(o.IsPaid ? "bg-success-subtle text-success border border-success" : "bg-danger-subtle text-danger border border-danger") px-2 py-1">
                                            @(o.IsPaid ? "پرداخت شده" : "پرداخت نشده")
                                        </span>
                                    </td>
                                    <td class="px-3 text-center">
                                        <div class="btn-group btn-group-sm">
                                            <button class="btn btn-outline-info" title="مشاهده" @onclick="() => ViewOrder(o.OrderId)">👁️</button>
                                            <button class="btn btn-outline-warning" title="ویرایش" @onclick="() => EditOrder(o.OrderId)">✏️</button>
                                            <button class="btn btn-outline-danger" title="حذف" @onclick="() => DeleteOrder(o.OrderId)">🗑️</button>
                                            <button class="btn @(o.IsPaid ? "btn-success" : "btn-outline-secondary")" title="تغییر وضعیت پرداخت" @onclick="() => TogglePayment(o.OrderId)">
                                                @(o.IsPaid ? "✅" : "⏳")
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- نمایش موبایل (کارت‌ها) -->
    <div class="d-md-none">
        @if (pagedOrders == null || !pagedOrders.Any())
        {
            <div class="card border-0 shadow-sm rounded-3 text-center text-muted small py-4">
                هیچ سفارشی یافت نشد.
            </div>
        }
        else
        {
            @foreach (var o in pagedOrders)
            {
                <div class="card border-0 shadow-sm mb-2 rounded-3">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div>
                                <span class="badge bg-secondary me-1">#@o.OrderId</span>
                                <span class="fw-bold fs-6">@o.CustomerName</span>
                            </div>
                            <span class="badge @(o.IsPaid ? "bg-success" : "bg-danger")">
                                @(o.IsPaid ? "پرداخت شده" : "پرداخت نشده")
                            </span>
                        </div>
                        
                        <div class="row g-1 small text-muted mb-2 bg-light p-2 rounded-2">
                            <div class="col-6">📅 ثبت: @o.OrderDate.ToPersianDate()</div>
                            <div class="col-6">📦 تحویل: @o.DeliveryDate.ToPersianDate()</div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center pt-1 border-top">
                            <div>
                                <span class="small text-muted d-block">مبلغ کل:</span>
                                <span class="fw-bold text-success fs-6">@o.TotalAmount.ToString("N0") تومان</span>
                            </div>
                            <div class="d-flex gap-1">
                                <button class="btn btn-sm btn-info text-white" @onclick="() => ViewOrder(o.OrderId)">👁️</button>
                                <button class="btn btn-sm btn-warning text-white" @onclick="() => EditOrder(o.OrderId)">✏️</button>
                                <button class="btn btn-sm btn-danger" @onclick="() => DeleteOrder(o.OrderId)">🗑️</button>
                                <button class="btn btn-sm @(o.IsPaid ? "btn-success" : "btn-outline-secondary")" @onclick="() => TogglePayment(o.OrderId)">
                                    @(o.IsPaid ? "✅" : "⏳")
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    <!-- صفحه‌بندی (Pagination) -->
    @if (totalPages > 1)
    {
        <div class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2 bg-white p-2 rounded-3 shadow-sm">
            <span class="small text-muted">صفحه @currentPage از @totalPages</span>
            <div class="d-flex gap-1 flex-wrap">
                <button class="btn btn-sm btn-outline-primary" disabled="@(currentPage == 1)" @onclick="() => GoToPage(currentPage - 1)">قبلی</button>
                @for (int i = 1; i <= totalPages; i++)
                {
                    int pageNumber = i;
                    <button class="btn btn-sm @(pageNumber == currentPage ? "btn-primary fw-bold" : "btn-outline-secondary")" @onclick="() => GoToPage(pageNumber)">@pageNumber</button>
                }
                <button class="btn btn-sm btn-outline-primary" disabled="@(currentPage == totalPages)" @onclick="() => GoToPage(currentPage + 1)">بعدی</button>
            </div>
        </div>
    }
</div>

@code {
    public class CustomerDto
    {
        public int CustomerId { get; set; }
        public string FullName { get; set; } = "";
    }

    public class OrderListModel
    {
        public int OrderId { get; set; }
        public string CustomerName { get; set; } = "";
        public DateTime OrderDate { get; set; }
        public DateTime DeliveryDate { get; set; }
        public decimal TotalAmount { get; set; }
        public bool IsPaid { get; set; }
        public DateTime? PaymentDate { get; set; }
        public string? Notes { get; set; }
    }

    private List<CustomerDto> customers = new();
    private List<OrderListModel> allOrders = new();
    private List<OrderListModel> pagedOrders = new();
    private int currentPage = 1;
    private int pageSize = 15;
    private int filterCustomerId = 0;
    private string? filterFromDateString;
    private string? filterToDateString;
    private DateTime? filterFromDate;
    private DateTime? filterToDate;
    private string filterPaymentStatus = "all";

    private int totalOrders => allOrders?.Count ?? 0;
    private decimal totalRevenue => allOrders?.Sum(o => o.TotalAmount) ?? 0;
    private int paidCount => allOrders?.Count(o => o.IsPaid) ?? 0;
    private int unpaidCount => allOrders?.Count(o => !o.IsPaid) ?? 0;
    private int totalPages => (int)Math.Ceiling((double)(allOrders?.Count ?? 0) / pageSize);

    protected override async Task OnInitializedAsync()
    {
        await LoadCustomers();
        await LoadOrders();
    }

    private async Task LoadCustomers()
    {
        try { customers = await Http.GetFromJsonAsync<List<CustomerDto>>("api/Customers") ?? new(); }
        catch { customers = new(); }
    }

    private async Task LoadOrders()
    {
        try
        {
            var url = "api/Orders";
            var queryParams = new List<string>();

            if (filterCustomerId > 0) queryParams.Add($"customerId={filterCustomerId}");
            if (filterFromDate.HasValue) queryParams.Add($"from={filterFromDate.Value:yyyy-MM-dd}");
            if (filterToDate.HasValue) queryParams.Add($"to={filterToDate.Value:yyyy-MM-dd}");
            if (filterPaymentStatus != "all") queryParams.Add($"isPaid={filterPaymentStatus == "paid"}");

            if (queryParams.Any()) url += "?" + string.Join("&", queryParams);

            allOrders = await Http.GetFromJsonAsync<List<OrderListModel>>(url) ?? new();
            currentPage = 1;
            UpdatePagedList();
        }
        catch { allOrders = new(); pagedOrders = new(); }
    }

    private void UpdatePagedList()
    {
        pagedOrders = allOrders.Skip((currentPage - 1) * pageSize).Take(pageSize).ToList();
    }

    private void GoToPage(int page)
    {
        if (page < 1 || page > totalPages) return;
        currentPage = page;
        UpdatePagedList();
    }

    private async Task ApplyFilters()
    {
        filterFromDate = ConvertPersianToGregorian(filterFromDateString);
        filterToDate = ConvertPersianToGregorian(filterToDateString);
        await LoadOrders();
    }

    private async Task ResetFilters()
    {
        filterCustomerId = 0;
        filterFromDateString = null;
        filterToDateString = null;
        filterFromDate = null;
        filterToDate = null;
        filterPaymentStatus = "all";
        await LoadOrders();
    }

    private DateTime? ConvertPersianToGregorian(string? persianDate)
    {
        if (string.IsNullOrEmpty(persianDate)) return null;
    
        var normalized = persianDate
            .Replace('۰', '0').Replace('۱', '1').Replace('۲', '2').Replace('۳', '3').Replace('۴', '4')
            .Replace('۵', '5').Replace('۶', '6').Replace('۷', '7').Replace('۸', '8').Replace('۹', '9');
        var parts = normalized.Split('/');
    
        if (parts.Length == 3 && 
            int.TryParse(parts[0], out int y) && 
            int.TryParse(parts[1], out int m) && 
            int.TryParse(parts[2], out int d))
        {
            var pc = new System.Globalization.PersianCalendar();
            return pc.ToDateTime(y, m, d, 0, 0, 0, 0);
        }
        return null;
    }

    private void ViewOrder(int id) => NavigationManager.NavigateTo($"/orders/details/{id}");
    private void EditOrder(int id) => NavigationManager.NavigateTo($"/orders/edit/{id}");

    private async Task DeleteOrder(int id)
    {
        var confirmed = await JsRuntime.InvokeAsync<bool>("confirm", "آیا از حذف این سفارش مطمئن هستید؟");
        if (!confirmed) return;

        try
        {
            await Http.DeleteAsync($"api/Orders/{id}");
            await LoadOrders();
        }
        catch { }
    }

    private async Task TogglePayment(int orderId)
    {
        var order = allOrders.FirstOrDefault(o => o.OrderId == orderId);
        if (order == null) return;

        var newStatus = !order.IsPaid;
        var statusText = newStatus ? "پرداخت شده" : "پرداخت نشده";

        var confirm = await JsRuntime.InvokeAsync<bool>("confirm", $"آیا از تغییر وضعیت به '{statusText}' مطمئن هستید؟");
        if (!confirm) return;

        try
        {
            var response = await Http.PutAsJsonAsync($"api/Orders/{orderId}/toggle-payment", new { IsPaid = newStatus });
            if (response.IsSuccessStatusCode)
            {
                order.IsPaid = newStatus;
                StateHasChanged();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                await JsRuntime.InvokeVoidAsync("alert", $"❌ خطا: {error}");
            }
        }
        catch (Exception ex)
        {
            await JsRuntime.InvokeVoidAsync("alert", $"❌ خطا: {ex.Message}");
        }
    }
}